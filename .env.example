# Stage 02 runs only in Emulator Suite. The production client is deliberately blocked.
EXPO_PUBLIC_FIREBASE_MODE=emulator
# Desktop/iOS simulator: 127.0.0.1; Android emulator: 10.0.2.2.
# A physical device requires a separately configured trusted LAN emulator binding.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
