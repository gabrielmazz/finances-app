# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
backend/lib/
backend/*-debug.log

# Firebase / generated build output
.firebase/
*-debug.log
dist/
web-build/
coverage/

# Expo
.expo/
expo-env.d.ts

# Native
.kotlin/
google-services.json
GoogleService-Info.plist
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*

# macOS
.DS_Store
*.pem
Thumbs.db
Desktop.ini

# Windows metadata accidentally copied with documents
*:Zone.Identifier

# Local editor and tool state
.idea/
.history/
.fleet/

# local env files
.env
.env*.local
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Ignorar arquivos do Visual Studio Code
.vscode/

# Ignora os scripts do Git
git-branch.sh
git-commit.sh
git-pull.sh
git-revert.sh

# Ignora as skills utilizadas no projeto
.agents/
.claude/
.codex/
