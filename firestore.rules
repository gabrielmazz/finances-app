        && data.schemaVersion is int && data.schemaVersion == 1 && data.domain in ['category', 'cdi'] && validSparkId(data.recordId)
        && originId == data.domain + '_' + data.recordId && source.personId == request.auth.uid && data.source == source
        && data.createdAt == request.time && validSparkOperationId(data.operationId) && !exists(path)
