        && data.usageType in ['expense', 'gain', 'both'] && data.isMandatoryExpense is bool && data.isMandatoryGain is bool && data.showInBothLists is bool
        && (data.usageType != 'gain' || !data.isMandatoryExpense) && (data.usageType != 'expense' || !data.isMandatoryGain)
        && (!data.showInBothLists || (data.usageType == 'gain' || data.isMandatoryExpense) && (data.usageType == 'expense' || data.isMandatoryGain))
        && isShortText(data.iconFamily, 100) && isShortText(data.iconName, 100) && isShortText(data.iconStyle, 100)
        && data.historyKnown is bool && data.deleted is bool && data.revision is int && data.revision >= 0 && data.revision <= 1000000000000
        && data.createdAt is timestamp && data.updatedAt == request.time && validSparkOperationId(data.lastOperationId) && !exists(path)
        && op.kind in ['category_save', 'category_delete'] && op.categoryId == categoryId && op.actorId == request.auth.uid && op.createdAt == request.time
        && op.expectedRevision == (resource == null ? null : resource.data.get('revision', null))
