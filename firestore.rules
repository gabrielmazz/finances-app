          : data.keys().hasAll(['name', 'usageType', 'isMandatoryExpense', 'isMandatoryGain', 'showInBothLists', 'iconFamily', 'iconName', 'iconStyle'])
            && data.keys().hasOnly(['schemaVersion', 'actorId', 'kind', 'categoryId', 'expectedRevision', 'createdAt', 'name', 'usageType', 'isMandatoryExpense', 'isMandatoryGain', 'showInBothLists', 'iconFamily', 'iconName', 'iconStyle', 'expectedFingerprint', 'assistantRequestFingerprint', 'commandMaterial']))
