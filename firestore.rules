rules_version = '2';
// Local candidate; NOT published. Stage03 source: security/stage03-published.rules.
// financialContexts/{personal:uid|group:gid}/bankAccounts/{operationId}: schemaVersion=1,
// bounded name/institutionKey/institutionName/type/color, scopeKind/scopeId, integer
// initialBalanceCents (+/-9e12), openingDate, status, revision and server audit fields.
// accountOpenings/{same operationId}: immutable opening, amount/date/context matching
// the account, reason<=500, type='opening'. Both documents MUST be created atomically.
// Movement transactions update account balances atomically; zero-balance accounts can archive.
// users/{uid}: legacy fields retained; clients create a minimal own profile or edit
// their own bounded name. Permission/relationship fields cannot be changed.
// _authorizations/{uid}: IAM-only {generation:string, enabled:bool, readOwners:list<=5,
// groups:map<=5}. Requires matching Auth custom claim lumusAccess, minted by IAM.
// Legacy profile/group membership fields alone never establish authorization.
// Financial documents: immutable legacy personId ownership, read only, pages <=20.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function hasAuthorityClaim() {
      return isAuthenticated() && request.auth.token.get('lumusAccess', '') is string
        && request.auth.token.get('lumusAccess', '').matches('^[A-Za-z0-9_-]{16,64}$');
    }
    function authorization() {
      return get(/databases/$(database)/documents/_authorizations/$(request.auth.uid)).data;
    }
    function validAuthorization(data) {
      return data.generation == request.auth.token.lumusAccess && data.enabled == true
        && data.readOwners is list && data.readOwners.size() <= 5
        && data.groups is map && data.groups.size() <= 5;
    }
    function verifiedAuthorization() { return validAuthorization(authorization()); }
    function mayReadOwner(owner) {
      return isAuthenticated() && owner is string && (owner == request.auth.uid ||
        (hasAuthorityClaim() && verifiedAuthorization() && owner in authorization().readOwners));
    }
    function hasGroupAccess(groupId) {
      return hasAuthorityClaim() && verifiedAuthorization()
        && authorization().groups.get(groupId, '') in ['admin', 'member'];
    }
    function legacyCollection(name) {
      return name in ['financeInvestmentSyncs',
        'financeInvestments','investmentCdiRates','mandatoryExpenses','mandatoryGains',
        'monthlyBalances'];
    }
    function legacyMovementRead(data) {
      let group = data.get('groupId',null);
      return data.keys().hasAll(['groupId','financialGroupId','ledgerGroupId']) && group == null
          && data.financialGroupId == null && data.ledgerGroupId == null && mayReadOwner(data.personId);
    }
    // Individual legacy reads were explicitly authorized for the signed-in
    // owner when group metadata is absent. This is never used for queries.
    function ownLegacyDocument(data) {
      return isAuthenticated() && data.get('personId',null) == request.auth.uid
        && data.get('groupId',null) == null && data.get('financialGroupId',null) == null
        && data.get('ledgerGroupId',null) == null;
    }
    function matchingLegacyBinding(data,kind,id) {
      return data.keys().hasOnly(['scopeKind','scopeId']) && data.scopeKind == kind && data.scopeId == id;
    }
    function personalLegacyBindingSafe(collection,id,owner) {
      let binding = /databases/$(database)/documents/$(collection)/$(id);
      return !exists(binding) || matchingLegacyBinding(get(binding).data,'personal',owner);
    }
    function groupLegacyBankBindingSafe(id,data) {
      let binding = /databases/$(database)/documents/_bankScopes/$(id);
      let group = data.get('groupId',null) != null ? data.groupId : data.get('financialGroupId',null) != null ? data.financialGroupId : data.get('ledgerGroupId',null);
      return !exists(binding) || matchingLegacyBinding(get(binding).data,'group',group);
    }
    function legacyGroupDocument(data) {
      let group = data.get('groupId',null) != null ? data.groupId
        : data.get('financialGroupId',null) != null ? data.financialGroupId : data.get('ledgerGroupId',null);
      return group is string && data.get('groupId',null) in [null,group]
        && data.get('financialGroupId',null) in [null,group] && data.get('ledgerGroupId',null) in [null,group]
        && mayReadOwner(data.personId) && hasGroupAccess(group) && activeGroup(group);
    }
    // Optional, server-managed binding for a legacy personal bank whose group
    // fields are missing. Clients cannot create or update this document.
    function protectedPersonalBank(id,data) {
      let binding = /databases/$(database)/documents/_bankScopes/$(id);
      return isAuthenticated() && data.personId == request.auth.uid
        && data.get('groupId',null) == null && data.get('financialGroupId',null) == null && data.get('ledgerGroupId',null) == null
        && exists(binding) && matchingLegacyBinding(get(binding).data,'personal',request.auth.uid);
    }
    function isValidName(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.name.matches('.*[^ ].*') && !data.name.matches('.*[\\x00-\\x1F\\x7F].*');
    }
    function isValidUser(data) { return data.keys().hasAll(['name']) && isValidName(data); }
    function boundedText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max
        && value.matches('.*[^ ].*') && !value.matches('.*[\\x00-\\x1F\\x7F].*');
    }
    function validBankMetadata(data) {
      return isValidName(data) && boundedText(data.institutionName,100)
        && data.institutionKey is string && data.institutionKey.matches('^[a-z0-9-]{1,64}$')
        && data.accountType in ['checking','savings','payment','cash']
        && (data.colorHex == null || (data.colorHex is string && data.colorHex.matches('^#[a-fA-F0-9]{6}$')));
    }
    function contextId(key) { return key.split(':')[1]; }
    function validContext(key) { return key.matches('^(personal|group):[A-Za-z0-9_-]{1,128}$'); }
    function activeGroup(id) {
      return get(/databases/$(database)/documents/financialGroups/$(id)).data.status == 'active';
    }
    function mayReadContext(key) {
      return isAuthenticated() && validContext(key) &&
        ((key.split(':')[0] == 'personal' && isOwner(contextId(key))) ||
         (key.split(':')[0] == 'group' && hasGroupAccess(contextId(key)) && activeGroup(contextId(key))));
    }
    function mayWriteContext(key) {
      let parts = key.split(':');
      return isAuthenticated() && validContext(key)
        && (parts[0] == 'personal' ? request.auth.uid == parts[1] : hasActiveGroupAdmin(parts[1]));
    }
    function hasActiveGroupAdmin(id) {
      let grant = authorization();
      return hasAuthorityClaim() && validAuthorization(grant) && grant.groups.get(id,'') == 'admin' && activeGroup(id);
    }
    function verifiedCategoryScope(id) {
      return get(/databases/$(database)/documents/_categoryScopes/$(id)).data;
    }
    function validLegacyCategoryScope(data, binding) {
      return binding.keys().hasOnly(['scopeKind','scopeId'])
        && binding.scopeKind in ['personal','group'] && binding.scopeId is string
        && validContext(binding.scopeKind + ':' + binding.scopeId)
        && ((binding.scopeKind == 'personal' && data.personId == binding.scopeId
          && data.get('groupId',null) == null && data.get('financialGroupId',null) == null && data.get('ledgerGroupId',null) == null)
        || (binding.scopeKind == 'group' && data.get('groupId',null) == binding.scopeId
          && data.get('financialGroupId',null) in [null,binding.scopeId] && data.get('ledgerGroupId',null) in [null,binding.scopeId]));
    }
    function validAmount(value) { return value is int && value >= -9000000000000 && value <= 9000000000000; }
    function validAccount(data,key) {
      return data.keys().hasOnly(['schemaVersion','scopeKind','scopeId','name','institutionKey','institutionName','accountType','colorHex','initialBalanceCents','openingDate','status','revision','createdBy','updatedBy','createdAt','updatedAt','balanceCents','balanceRevision','lastMovementId','legacyBankId'])
        && data.keys().hasAll(['schemaVersion','scopeKind','scopeId','name','institutionKey','institutionName','accountType','colorHex','initialBalanceCents','openingDate','status','revision','createdBy','updatedBy','createdAt','updatedAt'])
        && data.schemaVersion is int && data.schemaVersion == 1 && data.scopeKind in ['personal','group']
        && (!data.keys().hasAny(['legacyBankId']) || (data.scopeKind == 'personal' && data.legacyBankId is string && data.legacyBankId.matches('^[A-Za-z0-9]{20}$')))
        && data.scopeId is string && data.scopeId.size() > 0 && data.scopeId.size() <= 128 && key == data.scopeKind + ':' + data.scopeId
        && validBankMetadata(data) && validAmount(data.initialBalanceCents)
        && ((!data.keys().hasAny(['balanceCents','balanceRevision','lastMovementId'])) ||
          (data.keys().hasAll(['balanceCents','balanceRevision','lastMovementId']) && validAmount(data.balanceCents)
            && data.balanceRevision is int && data.balanceRevision > 0 && data.balanceRevision <= 1000000000
            && data.lastMovementId is string && data.lastMovementId.matches('^[A-Za-z0-9]{20}$')))
        && data.openingDate is timestamp && data.openingDate >= timestamp.date(1900,1,1) && data.openingDate <= request.time
        && data.status in ['active','archived'] && data.revision is int && data.revision >= 0 && data.revision <= 1000000000
        && data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128
        && data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 128
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validOpening(data,key,id) {
      return data.keys().hasOnly(['schemaVersion','accountId','scopeKind','scopeId','type','amountCents','date','reason','createdBy','createdAt','confirmed','pendingReviewed'])
        && data.keys().hasAll(['schemaVersion','accountId','scopeKind','scopeId','type','amountCents','date','reason','createdBy','createdAt'])
        && data.schemaVersion is int && data.schemaVersion == 1 && data.accountId == id
        && ((data.type == 'opening' && !data.keys().hasAny(['confirmed','pendingReviewed']))
          || (data.type == 'reference' && data.confirmed == true && data.pendingReviewed == true))
        && data.scopeKind in ['personal','group'] && data.scopeId is string && data.scopeId.size() > 0 && data.scopeId.size() <= 128 && key == data.scopeKind + ':' + data.scopeId
        && validAmount(data.amountCents) && data.date is timestamp && data.date >= timestamp.date(1900,1,1) && data.date <= request.time
        && data.reason is string && data.reason.size() <= 500 && !data.reason.matches('.*[\\x00-\\x1F\\x7F].*')
        && ((data.amountCents >= 0 && data.reason == '') || (data.amountCents < 0 && boundedText(data.reason,500) && data.reason.size() >= 3))
        && data.createdBy == request.auth.uid && data.createdAt == request.time;
    }
    function legacyMetadataUpdate() {
      let data = request.resource.data;
      return data.keys().hasAll(['name','bankIconKey','institutionName','accountType','colorHex','metadataRevision','updatedBy','updatedAt'])
        && validBankMetadata({'name':data.name,'institutionKey':data.bankIconKey,'institutionName':data.institutionName,'accountType':data.accountType,'colorHex':data.colorHex})
        && data.metadataRevision is int && data.metadataRevision == resource.data.get('metadataRevision',0) + 1
        && data.metadataRevision <= 1000000000 && data.updatedBy == request.auth.uid && data.updatedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly(['name','bankIconKey','institutionName','accountType','colorHex','metadataRevision','updatedBy','updatedAt'])
        && data.diff(resource.data).affectedKeys().hasAny(['name','bankIconKey','institutionName','accountType','colorHex']);
    }
    function validLegacyCategoryState(data) {
      return data.get('deleted',false) is bool
        && data.get('isMandatoryExpense',false) is bool && data.get('isMandatoryGain',false) is bool
        && data.get('showInBothLists',false) is bool
        && data.get('usageType',null) in [null,'expense','gain','both']
        && data.get('status','active') in ['active','archived']
        && (data.get('usageType',null) != 'expense' || !data.get('isMandatoryGain',false))
        && (data.get('usageType',null) != 'gain' || !data.get('isMandatoryExpense',false));
    }
    function legacyCategoryUpdate() {
      let data = request.resource.data;
      return validLegacyCategoryState(resource.data) && validLegacyCategoryState(data)
        && resource.data.get('deleted', false) != true && resource.data.get('status','active') == 'active'
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time
        && ((data.diff(resource.data).affectedKeys().hasOnly(['name','iconFamily','iconName','iconStyle','usageType','isMandatoryExpense','isMandatoryGain','showInBothLists','updatedBy','updatedAt'])
          && isValidName(data)
          && (data.get('iconFamily',null) == null || boundedText(data.iconFamily,100))
          && (data.get('iconName',null) == null || boundedText(data.iconName,100))
          && (data.get('iconStyle',null) == null || boundedText(data.iconStyle,100))
          && (!data.diff(resource.data).affectedKeys().hasAny(['usageType','isMandatoryExpense','isMandatoryGain','showInBothLists'])
            || (data.usageType in ['expense','gain','both'] && data.isMandatoryExpense is bool
              && data.isMandatoryGain is bool && data.showInBothLists is bool
              && (data.usageType != 'expense' || !data.isMandatoryGain)
              && (data.usageType != 'gain' || !data.isMandatoryExpense))))
        || (data.diff(resource.data).affectedKeys().hasOnly(['deleted','updatedBy','updatedAt']) && data.deleted == true));
    }
    function validCategory(data, key) {
      return data.keys().hasOnly(['schemaVersion','scopeKind','scopeId','name','usageType','isMandatoryExpense','isMandatoryGain','showInBothLists','iconFamily','iconName','iconStyle','nameKey','status','revision','createdBy','updatedBy','createdAt','updatedAt'])
        && data.keys().hasAll(['schemaVersion','scopeKind','scopeId','name','usageType','isMandatoryExpense','isMandatoryGain','showInBothLists','iconFamily','iconName','iconStyle','status','revision','createdBy','updatedBy','createdAt','updatedAt'])
        && data.schemaVersion == 1 && data.scopeKind in ['personal','group'] && key == data.scopeKind + ':' + data.scopeId
        && isValidName(data) && data.usageType in ['expense','gain','both']
        && data.isMandatoryExpense is bool && data.isMandatoryGain is bool && data.showInBothLists is bool
        && (data.usageType != 'expense' || !data.isMandatoryGain)
        && (data.usageType != 'gain' || !data.isMandatoryExpense)
        && (data.iconFamily == null || boundedText(data.iconFamily,100))
        && (data.iconName == null || boundedText(data.iconName,100))
        && (data.iconStyle == null || boundedText(data.iconStyle,100))
        && (!data.keys().hasAny(['nameKey']) || (data.nameKey is string && data.nameKey.size() <= 1300))
        && data.status in ['active','archived'] && data.revision is int && data.revision >= 0 && data.revision <= 1000000000
        && boundedText(data.createdBy,128) && boundedText(data.updatedBy,128)
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    match /financialContexts/{key}/categories/{id} {
      allow get: if mayReadContext(key);
      allow list: if mayReadContext(key) && request.query.limit <= 20;
      allow create: if mayWriteContext(key) && id.matches('^[A-Za-z0-9]{20}$') && validCategory(request.resource.data,key)
        && !request.resource.data.keys().hasAny(['nameKey'])
        && request.resource.data.status == 'active' && request.resource.data.revision == 0
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if mayWriteContext(key) && validCategory(request.resource.data,key)
        && resource.data.status == 'active' && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','usageType','isMandatoryExpense','isMandatoryGain','showInBothLists','iconFamily','iconName','iconStyle','status','revision','updatedBy','updatedAt'])
        && (request.resource.data.status == 'active' || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revision','updatedBy','updatedAt']));
    }
    function validMandatoryTemplate(data) {
      return data.keys().hasOnly(['type','name','valueInCents','categoryId','categorySource','description','dueDay','usesBusinessDays',
          'installmentTotal','installmentTotalValueInCents','installmentStartDate','installmentsCompleted','lastCycle',
          'lastMovementDate','lastAmountCents','lastInstallments','isActive','revision','updatedBy','updatedAt'])
        && data.type in ['gain','expense'] && isValidName(data)
        && validAmount(data.valueInCents) && data.valueInCents > 0
        && data.description is string && data.description.size() <= 500
        && data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 1500 && !data.categoryId.matches('.*/.*')
        && data.categorySource in ['new','legacy','group-root','group-legacy']
        && data.usesBusinessDays is bool && data.dueDay is int && data.dueDay >= 1 && data.dueDay <= (data.usesBusinessDays ? 23 : 31)
        && data.isActive is bool && data.revision is int && data.revision >= 0 && data.revision <= 1000000000
        && data.installmentsCompleted is int && data.installmentsCompleted >= 0
        && validMandatoryInstallments(data)
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }
    function validMandatoryInstallments(data) {
      return data.installmentTotal == null
        ? data.installmentTotalValueInCents == null && data.installmentStartDate == null && data.installmentsCompleted == 0
        : data.installmentTotal is int && data.installmentTotal >= 1 && data.installmentTotal <= 360
          && data.installmentsCompleted <= data.installmentTotal
          && validAmount(data.installmentTotalValueInCents)
          && data.valueInCents * data.installmentTotal <= data.installmentTotalValueInCents
          && (data.valueInCents + 1) * data.installmentTotal > data.installmentTotalValueInCents
          && data.installmentStartDate is timestamp && data.installmentStartDate == data.installmentStartDate.date()
          && data.installmentStartDate >= timestamp.date(1900,1,1);
    }
    function mandatoryCategory(data,key) {
      return movementCategory({'type': data.type, 'isFromMandatory': true, 'categoryId': data.categoryId,
        'categorySource': data.categorySource, 'scopeKind': key.split(':')[0], 'scopeId': contextId(key)},key);
    }
    function cycleKey(date) {
      return string(date.year()) + '-' + (date.month() < 10 ? '0' : '') + string(date.month());
    }
    function cycleNumber(cycle) {
      return int(cycle.split('-')[0]) * 12 + int(cycle.split('-')[1]);
    }
    function validMandatoryConfirmation(before,after,movement) {
      let count = movement.installmentCount;
      let completed = before.installmentsCompleted + count;
      return after.lastMovementDate == movement.date && after.lastAmountCents == movement.amountCents
        && count is int && count > 0 && after.lastInstallments == count
        && (before.lastCycle == null || cycleNumber(after.lastCycle) >= cycleNumber(before.lastCycle))
        && (before.installmentTotal == null
          ? count == 1 && after.installmentsCompleted == 0 && movement.amountCents == before.valueInCents
          : completed <= before.installmentTotal && after.installmentsCompleted == completed
            && cycleNumber(after.lastCycle) >= cycleNumber(cycleKey(before.installmentStartDate))
            && movement.amountCents == (completed == before.installmentTotal
              ? before.installmentTotalValueInCents - before.installmentsCompleted * before.valueInCents
              : count * before.valueInCents));
    }
    function validMandatoryCycleChange(before,after,key,id) {
      let movementId = id + '-' + after.lastCycle;
      let path = /databases/$(database)/documents/financialContexts/$(key)/movements/$(movementId);
      let movement = getAfter(path).data;
      let existing = exists(path);
      return after.diff(before).affectedKeys().hasOnly(['revision','updatedBy','updatedAt','lastCycle','lastMovementDate','lastAmountCents','lastInstallments','installmentsCompleted'])
        && movement.recurringTemplateId == id && after.lastCycle == cycleKey(movement.date)
        && (existing ? movement.revision == get(path).data.revision + 1 : movement.revision == 0)
        && (movement.status == 'posted'
          ? (!existing || get(path).data.status == 'cancelled') && validMandatoryConfirmation(before,after,movement)
          : existing && get(path).data.status == 'posted' && movement.status == 'cancelled'
            && before.lastCycle == after.lastCycle && before.lastMovementDate == movement.date
            && after.lastMovementDate == null && after.lastAmountCents == null && after.lastInstallments == 0
            && after.installmentsCompleted == before.installmentsCompleted - (before.installmentTotal == null ? 0 : before.lastInstallments));
    }
    match /financialContexts/{key}/mandatoryTemplates/{id} {
      allow get: if mayReadContext(key);
      allow list: if mayReadContext(key) && request.query.limit <= 20;
      allow create: if mayWriteContext(key) && id.matches('^[A-Za-z0-9]{20}$')
        && validMandatoryTemplate(request.resource.data) && mandatoryCategory(request.resource.data,key)
        && request.resource.data.revision == 0 && request.resource.data.isActive && request.resource.data.installmentsCompleted == 0
        && request.resource.data.lastCycle == null && request.resource.data.lastMovementDate == null
        && request.resource.data.lastAmountCents == null && request.resource.data.lastInstallments == 0;
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastCycle','lastMovementDate'])
        && mayWriteContext(key) && resource.data.isActive && validMandatoryTemplate(request.resource.data)
        && request.resource.data.type == resource.data.type && request.resource.data.revision == resource.data.revision + 1
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive','revision','updatedBy','updatedAt']) && !request.resource.data.isActive
          || request.resource.data.isActive &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','valueInCents','categoryId','categorySource','description',
              'dueDay','usesBusinessDays','installmentTotal','installmentTotalValueInCents','installmentStartDate','revision','updatedBy','updatedAt'])
            && (resource.data.installmentsCompleted == 0 || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['installmentTotal','installmentTotalValueInCents','installmentStartDate']))
            && mandatoryCategory(request.resource.data,key));
      // Only the ledger mutation in the same commit can authorize a cycle change.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastCycle','lastMovementDate'])
        && isAuthenticated() && resource.data.isActive && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.revision <= 1000000000 && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time && validMandatoryCycleChange(resource.data,request.resource.data,key,id);
    }
    function linkedMandatoryMovement(data,key,id) {
      let path = /databases/$(database)/documents/financialContexts/$(key)/mandatoryTemplates/$(data.recurringTemplateId);
      let before = get(path).data;
      let after = getAfter(path).data;
      let cycle = cycleKey(data.date);
      return data.recurringTemplateId is string && data.recurringTemplateId.matches('^[A-Za-z0-9]{20}$')
        && id == data.recurringTemplateId + '-' + cycle && data.date == data.date.date()
        && data.isFromMandatory == true && data.installmentCount is int
        && before.isActive && after.revision == before.revision + 1 && after.lastCycle == cycle
        && (data.status == 'posted'
          ? after.lastMovementDate == data.date && (before.lastCycle != after.lastCycle || before.lastMovementDate == null)
            && data.type == before.type && data.name == before.name && data.categoryId == before.categoryId && data.categorySource == before.categorySource
          : before.lastCycle == after.lastCycle && before.lastMovementDate == data.date && after.lastMovementDate == null);
    }
    function validOccurrence(data) {
      return !data.keys().hasAny(['occurredAt'])
        || (data.occurredAt is timestamp && data.occurredAt <= request.time
          && data.occurredAt.nanos() == 0 && data.occurredAt.seconds() % 60 == 0
          && (data.date == (data.occurredAt - duration.value(3,'h')).date()
            || (data.date < timestamp.date(2020,1,1) && data.date == (data.occurredAt - duration.value(2,'h')).date())));
    }
    function validMovement(data,key) {
      return data.keys().hasOnly(['schemaVersion','scopeKind','scopeId','name','type','amountCents','accountId','categoryId','categorySource','date','occurredAt','referenceTreatment','explanation','paymentFormats','status','revision','createdBy','updatedBy','createdAt','updatedAt','operation','transferId','isFromMandatory','recurringTemplateId','installmentCount'])
        && data.keys().hasAll(['schemaVersion','scopeKind','scopeId','name','type','amountCents','accountId','date','explanation','paymentFormats','status','revision','createdBy','updatedBy','createdAt','updatedAt'])
        && data.schemaVersion == 1 && data.scopeKind in ['personal','group'] && key == data.scopeKind + ':' + data.scopeId
        && isValidName(data) && data.type in ['gain','expense'] && validAmount(data.amountCents) && data.amountCents > 0
        && data.accountId is string && data.accountId.matches('^[A-Za-z0-9]{20}$')
        && data.date is timestamp && data.date >= timestamp.date(1900,1,1) && data.date <= (request.time - duration.value(3,'h')).date() && validOccurrence(data)
        && (!data.keys().hasAny(['referenceTreatment']) || data.referenceTreatment in ['historical','included','after'])
        && data.explanation is string && data.explanation.size() <= 500 && data.explanation.matches('[^\\x00-\\x1F\\x7F]*')
        && data.paymentFormats is list && data.paymentFormats.size() <= 1 && data.paymentFormats.hasOnly(['Variable','External'])
        && (data.type != 'expense' || data.paymentFormats.size() == 0)
        && data.status in ['posted','cancelled'] && data.revision is int && data.revision >= 0 && data.revision <= 1000000000
        && (data.keys().hasAny(['operation']) ? !data.keys().hasAny(['categoryId','categorySource','isFromMandatory','recurringTemplateId','installmentCount']) && data.paymentFormats.size() == 0 && data.date == data.date.date()
          : !data.keys().hasAny(['transferId']) && (!data.keys().hasAny(['isFromMandatory']) || data.isFromMandatory == true) && data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 1500
            && !data.categoryId.matches('.*/.*') && data.categorySource in ['new','legacy','group-root','group-legacy']);
    }
    function validTransferPair(data,key,id,outgoing,creating) {
      let counterpartId = outgoing ? data.transferId + '-credit' : data.transferId;
      let pair = /databases/$(database)/documents/financialContexts/$(key)/movements/$(counterpartId);
      let other = getAfter(pair).data;
      return data.transferId is string && data.transferId.matches('^[A-Za-z0-9]{20}$')
        && id == (outgoing ? data.transferId : data.transferId + '-credit')
        && data.type == (outgoing ? 'expense' : 'gain')
        && other.operation == (outgoing ? 'transfer-in' : 'transfer-out') && other.status == data.status
        && (creating ? !exists(pair) : get(pair).data.status == 'posted' && other.revision == get(pair).data.revision + 1)
        && other.transferId == data.transferId && other.accountId != data.accountId
        && other.amountCents == data.amountCents && other.date == data.date && other.explanation == data.explanation
        && other.get('occurredAt',null) == data.get('occurredAt',null);
    }
    function validMovementOperation(data,key,id) {
      return !data.keys().hasAny(['operation']) ? movementCategory(data,key)
        && (data.keys().hasAny(['recurringTemplateId','installmentCount'])
          ? linkedMandatoryMovement(data,key,id) : id.matches('^[A-Za-z0-9]{20}$'))
        : data.operation == 'cash-withdrawal' ? id.matches('^[A-Za-z0-9]{20}$') && data.type == 'expense' && !data.keys().hasAny(['transferId'])
        : data.operation in ['transfer-in','transfer-out'] && validTransferPair(data,key,id,data.operation == 'transfer-out',true);
    }
    function categoryMatchesMovement(category,data) {
      return category.get('usageType',null) in [data.type,'both']
        && (!data.get('isFromMandatory',false)
          || (data.type == 'gain' ? category.get('isMandatoryGain',false) : category.get('isMandatoryExpense',false)) == true);
    }
    function activeLegacyMovementCategory(category,data) {
      return validLegacyCategoryState(category) && category.get('deleted',false) == false
        && category.get('status','active') == 'active' && categoryMatchesMovement(category,data);
    }
    function rootMovementCategory(category,data,key,id) {
      let scope = verifiedCategoryScope(id);
      return validLegacyCategoryScope(category,scope) && key == scope.scopeKind + ':' + scope.scopeId
        && (data.categorySource == 'legacy' ? data.scopeKind == 'personal' : data.scopeKind == 'group')
        && activeLegacyMovementCategory(category,data);
    }
    function nestedMovementCategory(category,data) {
      return category.get('groupId',null) in [null,data.scopeId]
        && category.get('financialGroupId',null) in [null,data.scopeId]
        && category.get('ledgerGroupId',null) in [null,data.scopeId] && activeLegacyMovementCategory(category,data);
    }
    function movementCategory(data,key) {
      let id = data.categoryId;
      return (data.categorySource == 'new'
          && getAfter(/databases/$(database)/documents/financialContexts/$(key)/categories/$(id)).data.status == 'active'
          && categoryMatchesMovement(getAfter(/databases/$(database)/documents/financialContexts/$(key)/categories/$(id)).data,data))
        || (data.categorySource in ['legacy','group-root']
          && rootMovementCategory(getAfter(/databases/$(database)/documents/tags/$(id)).data,data,key,id))
        || (data.categorySource == 'group-legacy' && data.scopeKind == 'group'
          && nestedMovementCategory(getAfter(/databases/$(database)/documents/financialGroups/$(data.scopeId)/tags/$(id)).data,data));
    }
    function movementEffect(data) {
      return data.get('referenceTreatment','') in ['historical','included'] ? 0
        : data.type == 'gain' ? data.amountCents : -data.amountCents;
    }
    function validReferenceDay(data,opening) {
      let treatment = data.get('referenceTreatment','');
      let occurred = data.get('occurredAt',null);
      let day = (opening - duration.value(3,'h')).date();
      // Before 2020 UTC-02 was possible. Use the later candidate for new effects.
      let latestDay = opening < timestamp.date(2020,1,1) ? (opening - duration.value(2,'h')).date() : day;
      return treatment == '' ? (occurred == null ? data.date > latestDay : occurred > opening)
        : treatment == 'historical' ? data.date < latestDay
        : treatment == 'included' ? data.date >= day && data.date <= latestDay && (occurred == null || occurred <= opening)
        : treatment == 'after' && data.date == latestDay && (occurred == null || occurred > opening);
    }
    function validMovementAccountDate(key,data) {
      let account = get(/databases/$(database)/documents/financialContexts/$(key)/bankAccounts/$(data.accountId)).data;
      return data.date == data.date.date()
        && (account.keys().hasAny(['legacyBankId'])
          ? validReferenceDay(data,account.openingDate)
          : !data.keys().hasAny(['referenceTreatment']) && data.date >= account.openingDate.date());
    }
    function readableMovementAccount(key,data) {
      let account = get(/databases/$(database)/documents/financialContexts/$(key)/bankAccounts/$(data.accountId)).data;
      return !account.keys().hasAny(['legacyBankId']) || referenceAuthority(data.accountId,account);
    }
    function unusedHistoricalId(key,data,id) {
      let account = get(/databases/$(database)/documents/financialContexts/$(key)/bankAccounts/$(data.accountId)).data;
      return !account.keys().hasAny(['legacyBankId']) || (!exists(/databases/$(database)/documents/gains/$(id))
        && !exists(/databases/$(database)/documents/expenses/$(id)) && !exists(/databases/$(database)/documents/cashRescues/$(id))
        && !exists(/databases/$(database)/documents/bankTransfers/$(id)));
    }
    function unusedHistoricalIdForUpdate(key,before,after,id) {
      let fromAccount = get(/databases/$(database)/documents/financialContexts/$(key)/bankAccounts/$(before.accountId)).data;
      let toAccount = get(/databases/$(database)/documents/financialContexts/$(key)/bankAccounts/$(after.accountId)).data;
      return (!fromAccount.keys().hasAny(['legacyBankId']) && !toAccount.keys().hasAny(['legacyBankId']))
        || (!exists(/databases/$(database)/documents/gains/$(id)) && !exists(/databases/$(database)/documents/expenses/$(id))
          && !exists(/databases/$(database)/documents/cashRescues/$(id)) && !exists(/databases/$(database)/documents/bankTransfers/$(id)));
    }
    function referenceAuthority(id,data) {
      let legacy = get(/databases/$(database)/documents/banks/$(id)).data;
      let binding = /databases/$(database)/documents/_bankScopes/$(id);
      return data.legacyBankId == id && data.scopeKind == 'personal' && isOwner(data.scopeId)
        && legacy.personId == data.scopeId
        && (exists(binding) ? matchingLegacyBinding(get(binding).data,'personal',data.scopeId)
          : legacy.keys().hasAll(['groupId','financialGroupId','ledgerGroupId']))
        && legacy.get('groupId',null) == null && legacy.get('financialGroupId',null) == null && legacy.get('ledgerGroupId',null) == null
        && legacy.get('isActive',true) == true && legacy.get('archived',false) == false && legacy.get('status','active') == 'active';
    }
    function accountChangedForMovement(key,accountId,movementId) {
      let path = /databases/$(database)/documents/financialContexts/$(key)/bankAccounts/$(accountId);
      let before = get(path).data;
      let after = getAfter(path).data;
      return before.status == 'active' && after.lastMovementId == movementId
        && after.balanceRevision == before.get('balanceRevision',0) + 1;
    }
    function validMovementBalanceUpdate(key,accountId) {
      let id = request.resource.data.lastMovementId;
      let path = /databases/$(database)/documents/financialContexts/$(key)/movements/$(id);
      let after = getAfter(path).data;
      let existing = exists(path);
      let before = existing ? get(path).data : {};
      let removesEffect = existing && before.status == 'posted' && before.accountId == accountId;
      let postsEffect = after.status == 'posted' && after.accountId == accountId;
      let oldEffect = removesEffect ? movementEffect(before) : 0;
      let newEffect = postsEffect ? movementEffect(after) : 0;
      return (existing ? after.revision == before.revision + 1 : after.revision == 0)
        && (postsEffect || removesEffect)
        && (after.get('operation','') == '' ||
          (after.status == 'posted' ? newEffect >= 0 : oldEffect <= 0) ||
          request.resource.data.balanceCents >= 0)
        && request.resource.data.balanceRevision == resource.data.get('balanceRevision',0) + 1
        && request.resource.data.balanceCents == resource.data.get('balanceCents',resource.data.initialBalanceCents) + newEffect - oldEffect;
    }
    match /financialContexts/{key}/movements/{id} {
      allow get: if mayReadContext(key) && (!exists(/databases/$(database)/documents/financialContexts/$(key)/movements/$(id)) || readableMovementAccount(key,resource.data));
      allow list: if mayReadContext(key) && request.query.limit <= 20 && readableMovementAccount(key,resource.data);
      // A linked entry requires an authorized bank balance update in the same
      // transaction. The bank rule checks the caller and the amount delta.
      allow create: if (request.resource.data.keys().hasAll(['recurringTemplateId','installmentCount']) ? isAuthenticated() : mayWriteContext(key))
        && validMovement(request.resource.data,key)
        && request.resource.data.status == 'posted' && request.resource.data.revision == 0
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && validMovementOperation(request.resource.data,key,id) && validMovementAccountDate(key,request.resource.data)
        && unusedHistoricalId(key,request.resource.data,request.resource.data.get('transferId',id))
        && accountChangedForMovement(key,request.resource.data.accountId,id);
      allow update: if !resource.data.keys().hasAny(['operation','recurringTemplateId']) && mayWriteContext(key) && validMovementAccountDate(key,request.resource.data)
        && (request.resource.data.accountId == resource.data.accountId && request.resource.data.date == resource.data.date || validMovementAccountDate(key,resource.data))
        && unusedHistoricalIdForUpdate(key,resource.data,request.resource.data,id)
        && validMovement(request.resource.data,key) && resource.data.status == 'posted'
        && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','amountCents','accountId','categoryId','categorySource','date','occurredAt','referenceTreatment','explanation','paymentFormats','status','revision','updatedBy','updatedAt'])
        && (request.resource.data.status == 'posted' || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revision','updatedBy','updatedAt']))
        && (request.resource.data.accountId != resource.data.accountId || request.resource.data.date != resource.data.date
          || request.resource.data.get('referenceTreatment',null) == resource.data.get('referenceTreatment',null))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['categoryId','categorySource']) || movementCategory(request.resource.data,key))
        && accountChangedForMovement(key,resource.data.accountId,id)
        && (request.resource.data.accountId == resource.data.accountId || accountChangedForMovement(key,request.resource.data.accountId,id));
      allow update: if resource.data.keys().hasAny(['operation']) && !resource.data.keys().hasAny(['historicalSourcePath'])
        && mayWriteContext(key) && resource.data.status == 'posted' && request.resource.data.status == 'cancelled'
        && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.revision <= 1000000000
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revision','updatedBy','updatedAt'])
        && (resource.data.operation == 'cash-withdrawal' ||
          (resource.data.operation in ['transfer-out','transfer-in'] &&
            validTransferPair(request.resource.data,key,id,resource.data.operation == 'transfer-out',false)))
        && validMovementAccountDate(key,resource.data) && accountChangedForMovement(key,resource.data.accountId,id);
      allow update: if resource.data.keys().hasAny(['recurringTemplateId']) && !resource.data.keys().hasAny(['historicalSourcePath']) && isAuthenticated()
        && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.revision <= 1000000000
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && linkedMandatoryMovement(request.resource.data,key,id)
        && (resource.data.status == 'posted'
          ? request.resource.data.status == 'cancelled' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revision','updatedBy','updatedAt'])
          : resource.data.status == 'cancelled' && request.resource.data.status == 'posted'
            && validMovement(request.resource.data,key)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revision','updatedBy','updatedAt','name','amountCents','accountId','categoryId','categorySource','date','occurredAt','referenceTreatment','explanation','paymentFormats','installmentCount'])
            && movementCategory(request.resource.data,key))
        && validMovementAccountDate(key,request.resource.data) && unusedHistoricalId(key,request.resource.data,id)
        && accountChangedForMovement(key,request.resource.data.accountId,id);
    }
    match /financialContexts/{key}/bankAccounts/{id} {
      // Namespace authority comes from the path; missing-document reads are scoped too.
      allow get: if mayReadContext(key) && (!exists(/databases/$(database)/documents/financialContexts/$(key)/bankAccounts/$(id))
        || !resource.data.keys().hasAny(['legacyBankId']) || referenceAuthority(id,resource.data));
      // Resolve IDs through authorized openings or bindings, then use get.
      allow list: if false;
      allow create: if mayWriteContext(key) && id.matches('^[A-Za-z0-9]{20}$')
        && validAccount(request.resource.data,key) && !request.resource.data.keys().hasAny(['balanceCents','balanceRevision','lastMovementId'])
        && request.resource.data.status == 'active' && request.resource.data.revision == 0
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && (request.resource.data.keys().hasAny(['legacyBankId'])
          ? referenceAuthority(id,request.resource.data) && request.resource.data.name == get(/databases/$(database)/documents/banks/$(id)).data.name && getAfter(/databases/$(database)/documents/financialContexts/$(key)/accountOpenings/$(id)).data.type == 'reference'
          : getAfter(/databases/$(database)/documents/financialContexts/$(key)/accountOpenings/$(id)).data.type == 'opening'
            && (request.resource.data.scopeKind != 'personal' || !exists(/databases/$(database)/documents/banks/$(id)) || get(/databases/$(database)/documents/banks/$(id)).data.personId != request.auth.uid))
        && !exists(/databases/$(database)/documents/financialContexts/$(key)/accountOpenings/$(id))
        && getAfter(/databases/$(database)/documents/financialContexts/$(key)/accountOpenings/$(id)).data.accountId == id
        && getAfter(/databases/$(database)/documents/financialContexts/$(key)/accountOpenings/$(id)).data.amountCents == request.resource.data.initialBalanceCents
        && getAfter(/databases/$(database)/documents/financialContexts/$(key)/accountOpenings/$(id)).data.date == request.resource.data.openingDate;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny(['revision']) && mayWriteContext(key) && resource.data.status == 'active' && request.resource.data.revision == resource.data.revision + 1
        && (!resource.data.keys().hasAny(['legacyBankId']) || referenceAuthority(id,resource.data))
        && validAccount(request.resource.data,key)
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && ((request.resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','institutionKey','institutionName','accountType','colorHex','revision','updatedBy','updatedAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasAny(['name','institutionKey','institutionName','accountType','colorHex']))
        || (request.resource.data.status == 'archived' && !resource.data.keys().hasAny(['legacyBankId']) && resource.data.get('balanceCents',resource.data.initialBalanceCents) == 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revision','updatedBy','updatedAt'])));
      allow update: if mayWriteContext(key) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balanceCents','balanceRevision','lastMovementId']) && resource.data.status == 'active'
        && (!resource.data.keys().hasAny(['legacyBankId']) || referenceAuthority(id,resource.data))
        && validAmount(request.resource.data.balanceCents) && request.resource.data.balanceRevision is int
        && request.resource.data.balanceRevision > 0 && request.resource.data.balanceRevision <= 1000000000
        && request.resource.data.lastMovementId is string && request.resource.data.lastMovementId.matches('^[A-Za-z0-9]{20}(-credit|-[0-9]{4}-(0[1-9]|1[0-2]))?$')
        && validMovementBalanceUpdate(key,id);
    }
    match /financialContexts/{key}/accountOpenings/{id} {
      allow get: if mayReadContext(key) && (!exists(/databases/$(database)/documents/financialContexts/$(key)/accountOpenings/$(id))
        || resource.data.type != 'reference' || referenceAuthority(id,get(/databases/$(database)/documents/financialContexts/$(key)/bankAccounts/$(id)).data));
      // Normal openings are immutable and identify accounts that never used a
      // revocable legacy reference. Reference openings remain individual reads.
      allow list: if mayReadContext(key) && request.query.limit <= 20 && resource.data.type == 'opening';
      allow create: if mayWriteContext(key) && id.matches('^[A-Za-z0-9]{20}$') && validOpening(request.resource.data,key,id)
        && !exists(/databases/$(database)/documents/financialContexts/$(key)/bankAccounts/$(id))
        && getAfter(/databases/$(database)/documents/financialContexts/$(key)/bankAccounts/$(id)).data.initialBalanceCents == request.resource.data.amountCents
        && getAfter(/databases/$(database)/documents/financialContexts/$(key)/bankAccounts/$(id)).data.openingDate == request.resource.data.date;
    }
    match /_bankScopes/{id} {
      allow get: if isAuthenticated() && matchingLegacyBinding(resource.data,'personal',request.auth.uid)
        && ownLegacyDocument(get(/databases/$(database)/documents/banks/$(id)).data);
      allow list: if isAuthenticated() && request.query.limit <= 20 && resource.data.scopeKind == 'personal' && resource.data.scopeId == request.auth.uid
        && ownLegacyDocument(get(/databases/$(database)/documents/banks/$(id)).data);
    }
    match /banks/{id} {
      allow get: if protectedPersonalBank(id,resource.data);
      allow update: if isOwner(resource.data.personId) && legacyMovementRead(resource.data)
        && personalLegacyBindingSafe('_bankScopes',id,resource.data.personId) && legacyMetadataUpdate();
    }
    match /tags/{id} {
      allow get: if (ownLegacyDocument(resource.data) && personalLegacyBindingSafe('_categoryScopes',id,resource.data.personId)) || (validLegacyCategoryScope(resource.data, verifiedCategoryScope(id))
        && mayReadContext(verifiedCategoryScope(id).scopeKind + ':' + verifiedCategoryScope(id).scopeId));
      allow list: if request.query.limit <= 20 && resource.data.personId == request.auth.uid
        && resource.data.groupId == null && resource.data.financialGroupId == null && resource.data.ledgerGroupId == null
        && personalLegacyBindingSafe('_categoryScopes',id,resource.data.personId);
      allow update: if validLegacyCategoryScope(resource.data, verifiedCategoryScope(id))
        && mayWriteContext(verifiedCategoryScope(id).scopeKind + ':' + verifiedCategoryScope(id).scopeId)
        && legacyCategoryUpdate();
    }
    match /financialGroups/{groupId}/accounts/{id} {
      allow update: if mayWriteContext('group:'+groupId)
        && resource.data.get('groupId',null) in [null,groupId]
        && resource.data.get('financialGroupId',null) in [null,groupId]
        && resource.data.get('ledgerGroupId',null) in [null,groupId] && legacyMetadataUpdate();
    }
    match /financialGroups/{groupId}/tags/{id} {
      allow update: if mayWriteContext('group:'+groupId)
        && resource.data.get('groupId',null) in [null,groupId]
        && resource.data.get('financialGroupId',null) in [null,groupId]
        && resource.data.get('ledgerGroupId',null) in [null,groupId] && legacyCategoryUpdate();
    }
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUser(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'adminUser'])
        && request.resource.data.keys().hasAll(['email', 'createdAt', 'adminUser'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.adminUser == false
        && request.resource.data.createdAt == request.time;
      // Unknown legacy fields stay unchanged, including fields of incomplete profiles.
      allow update: if isOwner(uid) && isValidUser(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }
    match /financialGroups/{groupId} {
      allow get: if hasGroupAccess(groupId) && resource.data.status == 'active';
      match /{collection}/{id} {
        allow get: if collection in ['accounts','movements','monthlyBalances','tags']
          && hasGroupAccess(groupId)
          && get(/databases/$(database)/documents/financialGroups/$(groupId)).data.status == 'active';
        allow list: if request.query.limit <= 20
          && collection in ['accounts','movements','monthlyBalances','tags'] && hasGroupAccess(groupId)
          && get(/databases/$(database)/documents/financialGroups/$(groupId)).data.status == 'active';
      }
    }
    match /_authorizations/{uid} {
      allow get: if isOwner(uid) && hasAuthorityClaim() && validAuthorization(resource.data);
    }
    match /{collection}/{id} {
      allow get: if (legacyCollection(collection) || collection in ['banks','gains','expenses','cashRescues','bankTransfers'])
        && (((ownLegacyDocument(resource.data) || legacyMovementRead(resource.data)) && (collection != 'banks' || personalLegacyBindingSafe('_bankScopes',id,resource.data.personId)))
          || (legacyGroupDocument(resource.data) && (collection != 'banks' || groupLegacyBankBindingSafe(id,resource.data))));
      allow list: if request.query.limit <= 20 && (legacyCollection(collection) || collection in ['banks','gains','expenses','cashRescues','bankTransfers'])
          && resource.data.groupId == null
          && resource.data.financialGroupId == null && resource.data.ledgerGroupId == null
          && (collection != 'banks' || personalLegacyBindingSafe('_bankScopes',id,resource.data.personId))
          && mayReadOwner(resource.data.personId);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
