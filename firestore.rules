    }

    // [[Recorrências Spark]]: definição protegida, ciclos separados e efeitos financeiros atômicos.
    function validSparkCycle(cycle) {
      return cycle is string && cycle.matches('^(19[7-9][0-9]|20[0-9]{2}|2100)-(0[1-9]|1[0-2])$');
    }
    function sparkRecurringMonthIndex(cycle) {
      let at = get(/databases/$(database)/documents/sparkCivilMonths/$(cycle)).data.startAt;
      return at.year() * 12 + at.month();
    }
    function validSparkRecurringContract(data) {
      return validSparkCycle(data.startCycle) && isIntegerCents(data.valueInCents) && data.valueInCents > 0
        && (data.installmentTotal == null ? data.contractTotalInCents == null && data.endCycle == null
          : data.installmentTotal is int && data.installmentTotal >= 1 && data.installmentTotal <= 360
            && isIntegerCents(data.contractTotalInCents) && data.contractTotalInCents > 0
