        && data.rateId == request.auth.uid + '_' + data.cycle.split('-')[0] + data.cycle.split('-')[1] + (data.day < 10 ? '0' : '') + string(data.day)
        && data.effectiveFrom == (data.day == 1 ? month.startAt : month.dayEnds[data.day - 2] + duration.value(1, 'ms'))
