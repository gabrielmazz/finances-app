        && data.differenceInCents == (data.movementKind == 'income' ? 1 : -1) * data.amountInCents
        // Cada posição confere seus efeitos contra o próprio checkpoint; os dois heads abaixo obrigam esses updates.
        && validSparkPair(from, fromAfter, data.fromRevision, operationId) && validSparkPair(to, toAfter, data.toRevision, operationId)
        // Os guards obrigatórios das duas posições conferem efeito, saldo final e justificativa; evitar repeti-los no receipt.
        && validSparkMovementCategory(groupId, data.categoryId, data.movementKind)
