    function validSparkMovementClaim(groupId, originalId, source) {
      let data = request.resource.data;
      let path = /databases/$(database)/documents/financialGroups/$(groupId)/sparkOperations/$(data.reversalOperationId);
      let operation = getAfter(path).data;
      let originalPath = source == 'imported'
        ? /databases/$(database)/documents/financialGroups/$(groupId)/sparkImportedIdentities/$(originalId)
        : /databases/$(database)/documents/financialGroups/$(groupId)/sparkOperations/$(originalId);
      let original = get(originalPath).data;
      let kind = original.kind == 'movement_correction' ? original.movementKind : original.kind;
