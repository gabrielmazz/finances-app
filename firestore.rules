    function validSparkMovementCorrection(groupId, operationId) {
      let data = request.resource.data;
      let fromPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkPositions/$(data.fromAccountId);
      let toPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkPositions/$(data.toAccountId);
