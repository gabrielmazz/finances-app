      let rate = getAfter(/databases/$(database)/documents/investmentCdiRates/$(data.rateId)).data;
      return data.keys().hasAll(['schemaVersion', 'actorId', 'kind', 'rateId', 'cycle', 'day', 'effectiveFrom', 'annualRateInBasisPoints', 'expectedRevision', 'createdAt'])
        && data.keys().hasOnly(['schemaVersion', 'actorId', 'kind', 'rateId', 'cycle', 'day', 'effectiveFrom', 'annualRateInBasisPoints', 'expectedRevision', 'createdAt', 'expectedFingerprint', 'assistantRequestFingerprint', 'commandMaterial'])
