        && data.keys().hasOnly(['schemaVersion', 'actorId', 'kind', 'originalSource', 'originalOperationId', 'movementKind', 'originalDeltaInCents', 'fromAccountId', 'toAccountId', 'amountInCents', 'differenceInCents', 'effectiveAt', 'categoryId', 'note', 'overdraftReason', 'fromRevision', 'toRevision', 'fromPreviousOperationId', 'toPreviousOperationId', 'fromCurrentEffectInCents', 'toCurrentEffectInCents', 'createdAt', 'hasDetails', 'details', 'expectedFingerprint', 'assistantRequestFingerprint', 'commandMaterial'])
        && validSparkMetadataConfirmation(data)
