        && data.expectedRevision is int && isIntegerCents(data.differenceInCents) && isIntegerCents(data.currentEffectInCents)
        && data.currentEffectInCents == sparkMovementEffect(groupId, data.accountId, data.effectiveAt, data.differenceInCents)
        && validSparkPair(before, after, data.expectedRevision, operationId)
        && after.balanceInCents == before.balanceInCents + data.currentEffectInCents
        && validSparkMovementBalance(after.balanceInCents, data.overdraftReason) && validSparkMovementQuota(groupId, operationId)
        && (data.kind == 'movement_reversal'
          ? !data.keys().hasAny(['amountInCents', 'categoryId']) && data.accountId == data.fromAccountId
            && data.differenceInCents == -data.originalDeltaInCents && validSparkMovementResolution(groupId, operationId, data)
