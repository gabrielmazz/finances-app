rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // AUTH / USER
    // =========================================================

    function signedIn() {
      // [[Segurança de Login]]: token renovado conserva o instante do login.
      return request.auth != null
        && hasFreshLogin(request.auth.token.auth_time);
    }

    function hasFreshLogin(authTime) {
      return authTime is int
        && authTime > 0
        && request.time >= timestamp.value(authTime * 1000)
        && request.time < timestamp.value(authTime * 1000) + duration.value(8, 'h');
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function relatedUsers() {
      return currentUser().data.get('relatedIdUsers', []);
    }

    function sparkRelationshipPath(otherUserId) {
      return request.auth.uid < otherUserId
        ? /databases/$(database)/documents/sparkUserRelationships/$(request.auth.uid)/sparkRelationshipPairs/$(otherUserId)
        : /databases/$(database)/documents/sparkUserRelationships/$(otherUserId)/sparkRelationshipPairs/$(request.auth.uid);
    }

    function hasAcceptedRelationship(otherUserId) {
      // Um estado Spark (inclusive revogado) prevalece sobre concessões antigas.
      return signedIn() && (exists(sparkRelationshipPath(otherUserId))
        ? get(sparkRelationshipPath(otherUserId)).data.status == 'linked'
        : hasLegacyAcceptedRelationship(otherUserId));
    }

    function hasLegacyAcceptedRelationship(otherUserId) {
      return signedIn()
        && otherUserId in relatedUsers()
        && exists(/databases/$(database)/documents/users/$(otherUserId))
        && request.auth.uid in get(/databases/$(database)/documents/users/$(otherUserId)).data.get('relatedIdUsers', [])
        && exists(/databases/$(database)/documents/userRelationshipGrants/$(request.auth.uid)/related/$(otherUserId))
        && exists(/databases/$(database)/documents/userRelationshipGrants/$(otherUserId)/related/$(request.auth.uid));
    }

    // =========================================================
    // FINANCIAL GROUPS
    // =========================================================

    function group(groupId) {
      return get(
        /databases/$(database)/documents/financialGroups/$(groupId)
      );
    }

    function isMember(groupId) {
      return signedIn()
        && group(groupId).data.get('status', null) == 'active'
        && group(groupId).data
          .get('members', {})
          .get(request.auth.uid, null) in ['admin', 'member'];
    }

    function isAdmin(groupId) {
      return isMember(groupId)
        && group(groupId).data
          .get('members', {})
          .get(request.auth.uid, null) == 'admin';
    }

    // [[Protocolo Financeiro Spark]]: habilitação protegida, somente prova sintética.
    function sparkProofRole(groupId) {
      let data = group(groupId).data;
      return signedIn() && data.get('status', null) == 'active'
        && data.get('sparkProtocol', null) == 'financial-proof-v17'
        ? data.get('members', {}).get(request.auth.uid, null) : null;
    }

    function isSparkProofMember(groupId) {
      return sparkProofRole(groupId) in ['admin', 'member'];
    }

    // [[Autenticação]]: autorização deve ser emitida por operador confiável após verificar conta nova.
    // O cliente não pode criar ou alterar a autorização; todos os efeitos ocorrem no mesmo commit.
    function validSparkFirstUse(uid, groupId) {
      let permitPath = /databases/$(database)/documents/sparkFirstUseLocks/$(uid);
      let userPath = /databases/$(database)/documents/users/$(uid);
      let groupPath = /databases/$(database)/documents/financialGroups/$(groupId);
      let cashPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkPositions/cash;
      let operationPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkOperations/first_use_cash;
      return signedIn() && uid == request.auth.uid && groupId == 'first_' + uid
        && exists(permitPath) && exists(userPath) && !exists(groupPath) && !exists(cashPath) && !exists(operationPath)
        && !exists(/databases/$(database)/documents/financialCutovers/$(uid))
        && existsAfter(groupPath) && existsAfter(cashPath) && existsAfter(operationPath)
        && validSparkFirstUseData(uid, groupId, permitPath, userPath, groupPath, cashPath, operationPath);
    }
    function validSparkFirstUseData(uid, groupId, permitPath, userPath, groupPath, cashPath, operationPath) {
      let permit = get(permitPath).data;
      let before = get(userPath).data;
      let profile = getAfter(userPath).data;
      let group = getAfter(groupPath).data;
      let cash = getAfter(cashPath).data;
      let op = getAfter(operationPath).data;
      return permit.keys().hasOnly(['schemaVersion', 'status', 'actorId', 'groupId', 'profileCreatedAt', 'expiresAt', 'cycle', 'lockId'])
        && permit.schemaVersion == 1 && permit.actorId == uid && permit.groupId == groupId
        && permit.status == 'authorized' && permit.lockId is string && permit.lockId.matches('^[A-Za-z0-9_-]{16,160}$')
        && permit.profileCreatedAt is timestamp && permit.profileCreatedAt == before.createdAt
        && permit.expiresAt is timestamp && request.time < permit.expiresAt
        && permit.cycle is string && permit.cycle.matches('^(19[7-9][0-9]|20[0-9][0-9]|2100)-(0[1-9]|1[0-2])$')
        && exists(/databases/$(database)/documents/sparkCivilMonths/$(permit.cycle))
        && get(/databases/$(database)/documents/sparkCivilMonths/$(permit.cycle)).data.startAt <= request.time
        && request.time < get(/databases/$(database)/documents/sparkCivilMonths/$(permit.cycle)).data.endAt
        && before.get('sparkFirstUseRequested', false) == true
        && before.get('financialGroupId', null) == null && before.get('financialGroupRole', null) == null
        && before.get('financialLegacyCutoverAt', null) == null
        && profile.diff(before).affectedKeys().hasOnly(['financialGroupId', 'financialGroupRole', 'financialLegacyCutoverAt'])
        && profile.financialGroupId == groupId && profile.financialGroupRole == 'admin' && profile.financialLegacyCutoverAt == request.time
        && group.keys().hasOnly(['status', 'members', 'sparkProtocol', 'firstUseActorId', 'createdAt'])
        && group.status == 'active' && group.members is map && group.members.keys().hasOnly([uid]) && group.members.get(uid, null) == 'admin'
        && group.sparkProtocol == 'financial-proof-v17' && group.firstUseActorId == uid && group.createdAt == request.time
        && cash.keys().hasOnly(['schemaVersion', 'kind', 'active', 'balanceInCents', 'revision', 'lastOperationId', 'nextActivationAt', 'updatedAt'])
        && cash.schemaVersion == 1 && cash.kind == 'cash' && cash.active == true && cash.balanceInCents == 0
        && cash.revision == 0 && cash.lastOperationId == 'first_use_cash' && cash.nextActivationAt == null && cash.updatedAt == request.time
        && op.keys().hasOnly(['schemaVersion', 'actorId', 'kind', 'accountId', 'accountKind', 'openingBalanceInCents', 'note', 'createdAt'])
        && op.schemaVersion == 1 && op.actorId == uid && op.kind == 'account_opening' && op.accountId == 'cash'
        && op.accountKind == 'cash' && op.openingBalanceInCents == 0 && op.note == null && op.createdAt == request.time;
    }

    function validSparkId(id) {
      return id is string && id.size() >= 1 && id.size() <= 160 && id.matches('^[^/]+$');
    }

    function validSparkOperationId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{8,160}$');
    }

    function validSparkPosition(data) {
      return data.keys().hasAll(['schemaVersion', 'kind', 'active', 'balanceInCents', 'revision', 'lastOperationId', 'nextActivationAt', 'updatedAt'])
        && data.keys().hasOnly(['schemaVersion', 'kind', 'active', 'balanceInCents', 'revision', 'lastOperationId', 'nextActivationAt', 'updatedAt'])
        && data.schemaVersion is int && data.schemaVersion == 1 && data.active is bool
        && data.kind in ['bank', 'cash', 'investment']
        && isIntegerCents(data.balanceInCents)
        && (data.kind == 'bank' || data.balanceInCents >= 0)
        && data.revision is int && data.revision >= 0 && data.revision <= 1000000000000
        && (data.lastOperationId == null || validSparkOperationId(data.lastOperationId))
        && (data.nextActivationAt == null || data.nextActivationAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function sparkPairPositionDelta(groupId, accountId, operation) {
      let delta = operation.kind == 'investment_funding_change' ? sparkFundingDelta(operation, accountId)
        : operation.fromAccountId == accountId ? -operation.amountInCents : operation.amountInCents;
      return 'effectiveAt' in operation ? sparkMovementEffect(groupId, accountId, operation.effectiveAt, delta) : delta;
    }
    function sparkFundingDelta(op, accountId) {
      return op.refundAccountId == accountId ? op.previousPrincipalInCents : op.fromAccountId == accountId ? -op.principalInCents : op.differenceInCents;
    }
    function validSparkPositionEffect(groupId, accountId, operation) {
      return operation.actorId == request.auth.uid
        && (operation.kind == 'investment_edit_valuation'
          ? resource.data.kind == 'investment' && operation.accountId == accountId && operation.expectedRevision == resource.data.revision + 1
            && request.resource.data.balanceInCents == operation.targetBalanceInCents
          : operation.kind in ['recurring_settlement', 'recurring_reversal', 'income', 'expense', 'movement_reversal', 'account_count', 'balance_adjustment', 'adjustment_reversal', 'adjustment_replacement', 'dated_adjustment', 'dated_reconciliation', 'investment_sync', 'investment_valuation_reversal', 'monthly_opening', 'monthly_activation']
          ? operation.accountId == accountId && operation.expectedRevision == resource.data.revision
            && validSparkOperationId(operation.previousOperationId) && operation.previousOperationId == resource.data.lastOperationId
            && request.resource.data.balanceInCents == resource.data.balanceInCents + operation.currentEffectInCents
          : operation.kind == 'movement_correction'
            ? ((operation.fromAccountId == accountId && resource.data.revision == operation.fromRevision && resource.data.lastOperationId == operation.fromPreviousOperationId)
                || (operation.toAccountId == accountId && resource.data.revision == operation.toRevision && resource.data.lastOperationId == operation.toPreviousOperationId))
              && request.resource.data.balanceInCents == resource.data.balanceInCents
                + (operation.fromAccountId == accountId ? operation.fromCurrentEffectInCents : 0)
                + (operation.toAccountId == accountId ? operation.toCurrentEffectInCents : 0)
              && (operation.fromAccountId != accountId || operation.fromCurrentEffectInCents == sparkMovementEffect(groupId, accountId, operation.effectiveAt, -operation.originalDeltaInCents))
              && (operation.toAccountId != accountId || operation.toCurrentEffectInCents == sparkMovementEffect(groupId, accountId, operation.effectiveAt, operation.differenceInCents))
              && validSparkMovementBalance(request.resource.data.balanceInCents, operation.overdraftReason)
          : ((operation.fromAccountId == accountId
              && resource.data.revision == operation.fromRevision
              && validSparkOperationId(operation.fromPreviousOperationId) && operation.fromPreviousOperationId == resource.data.lastOperationId
              && request.resource.data.balanceInCents == resource.data.balanceInCents + sparkPairPositionDelta(groupId, accountId, operation))
          || (operation.toAccountId == accountId
              && resource.data.revision == operation.toRevision
              && validSparkOperationId(operation.toPreviousOperationId) && operation.toPreviousOperationId == resource.data.lastOperationId
              && request.resource.data.balanceInCents == resource.data.balanceInCents + sparkPairPositionDelta(groupId, accountId, operation))
          || (operation.kind == 'investment_funding_change' && operation.refundAccountId == accountId
              && resource.data.revision == operation.refundRevision && validSparkOperationId(operation.refundPreviousOperationId)
              && operation.refundPreviousOperationId == resource.data.lastOperationId
              && request.resource.data.balanceInCents == resource.data.balanceInCents + sparkPairPositionDelta(groupId, accountId, operation))));
    }

    function validSparkPositionUpdate(groupId, accountId) {
      let after = request.resource.data;
      let operationPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkOperations/$(after.lastOperationId);
      let operation = getAfter(operationPath).data;
      return validSparkPosition(resource.data) && validSparkPosition(after)
        && resource.data.active && after.active
        && validSparkOperationId(after.lastOperationId)
        && after.diff(resource.data).affectedKeys().hasOnly(['balanceInCents', 'revision', 'lastOperationId', 'nextActivationAt', 'updatedAt'])
        && after.revision == resource.data.revision + (operation.kind == 'investment_edit_valuation' ? 2 : 1)
        && after.updatedAt == request.time
        // Um recibo anterior jamais autoriza novos efeitos.
        && !exists(operationPath)
        && validSparkPositionDeadline(resource.data, after, operation)
        && validSparkPositionEffect(groupId, accountId, operation);
    }

    function validSparkPositionDeadline(before, after, operation) {
      return operation.kind == 'monthly_activation'
        ? after.nextActivationAt == operation.nextActivationAt
        : (before.nextActivationAt == null || request.time < before.nextActivationAt)
          && after.nextActivationAt == (operation.kind == 'monthly_opening' && operation.effectiveAt > request.time
              && (before.nextActivationAt == null || operation.effectiveAt < before.nextActivationAt)
            ? operation.effectiveAt : before.nextActivationAt);
    }

    function validSparkPair(before, after, revision, operationId) {
      // O incremento obriga update nas duas posições; seus guards já validam schema e imutabilidade.
      return before.revision == revision && after.revision == revision + 1
        && after.lastOperationId == operationId && after.updatedAt == request.time;
    }

    function validSparkKinds(kind, from, to) {
      return (kind == 'transfer' && from != 'investment' && to != 'investment')
        || (kind == 'investment_deposit' && from != 'investment' && to == 'investment')
        || (kind == 'investment_redemption' && from == 'investment' && to != 'investment');
    }

    function validSparkQuota(uid) {
      let data = request.resource.data;
      let operationPath = /databases/$(database)/documents/financialGroups/$(data.groupId)/sparkOperations/$(data.lastOperationId);
      let operation = getAfter(operationPath).data;
      return signedIn() && request.auth.uid == uid
        && data.keys().hasAll(['groupId', 'windowStartInMillis', 'count', 'lastOperationId', 'updatedAt'])
        && data.keys().hasOnly(['groupId', 'windowStartInMillis', 'count', 'lastOperationId', 'updatedAt'])
        && validSparkId(data.groupId) && isSparkProofMember(data.groupId)
        && data.windowStartInMillis is int
        && data.windowStartInMillis == int(request.time.toMillis() / 60000) * 60000
        && data.count is int && data.count > 0 && data.count <= 120
        && data.updatedAt == request.time && validSparkOperationId(data.lastOperationId)
        && ((resource == null && data.count == 1)
          || (resource != null && ((resource.data.windowStartInMillis == data.windowStartInMillis && data.count == resource.data.count + 1)
            || (resource.data.windowStartInMillis < data.windowStartInMillis && data.count == 1))))
        && !exists(operationPath) && operation.actorId == uid && operation.createdAt == request.time
        && validSparkRecoveryCommit(uid, data.groupId, data.lastOperationId, operation.kind);
    }

    // [[Recuperação de Operações Spark]]: o recibo e o cancelamento disputam a mesma intenção privada.
    function validSparkRecoveryCommit(uid, groupId, operationId, kind) {
      let indexPath = /databases/$(database)/documents/sparkOperationRecovery/$(uid);
      let intentPath = /databases/$(database)/documents/sparkOperationRecovery/$(uid)/intents/$(operationId);
      return (!exists(indexPath) || get(indexPath).data.operationId == operationId
          || get(/databases/$(database)/documents/sparkOperationRecovery/$(uid)/intents/$(get(indexPath).data.operationId)).data.status != 'pending')
        && (!exists(intentPath) || (get(intentPath).data.status == 'pending'
          && get(intentPath).data.groupId == groupId && get(intentPath).data.kind == kind
          && getAfter(intentPath).data.status == 'committed' && getAfter(intentPath).data.updatedAt == request.time));
    }
    function validSparkRecoveryIndex(uid) {
      let data = request.resource.data;
      let intentPath = /databases/$(database)/documents/sparkOperationRecovery/$(uid)/intents/$(data.operationId);
      return signedIn() && request.auth.uid == uid
        && data.keys().hasAll(['schemaVersion', 'groupId', 'operationId', 'updatedAt'])
        && data.keys().hasOnly(['schemaVersion', 'groupId', 'operationId', 'updatedAt'])
        && data.schemaVersion is int && data.schemaVersion == 1 && validSparkId(data.groupId) && validSparkOperationId(data.operationId)
        && data.updatedAt == request.time && !exists(intentPath)
        && getAfter(intentPath).data.status == 'pending' && getAfter(intentPath).data.groupId == data.groupId
        && (resource == null || getAfter(/databases/$(database)/documents/sparkOperationRecovery/$(uid)/intents/$(resource.data.operationId)).data.status in ['resolved', 'cancelled']);
    }
    function validSparkRecoveryCreate(uid, operationId) {
      let data = request.resource.data;
      let quota = getAfter(/databases/$(database)/documents/sparkOperationIntentQuotas/$(uid)).data;
      let index = getAfter(/databases/$(database)/documents/sparkOperationRecovery/$(uid)).data;
      return signedIn() && request.auth.uid == uid && validSparkOperationId(operationId)
        && data.keys().hasAll(['schemaVersion', 'groupId', 'kind', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['schemaVersion', 'groupId', 'kind', 'status', 'createdAt', 'updatedAt'])
        && data.schemaVersion is int && data.schemaVersion == 1 && validSparkId(data.groupId) && isSparkProofMember(data.groupId)
        && data.kind is string && data.kind.matches('^[a-z_]{1,64}$') && data.status == 'pending'
        && data.createdAt == request.time && data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/financialGroups/$(data.groupId)/sparkOperations/$(operationId))
        && !existsAfter(/databases/$(database)/documents/financialGroups/$(data.groupId)/sparkOperations/$(operationId))
        && index.groupId == data.groupId && index.operationId == operationId && index.updatedAt == request.time
        && quota.groupId == data.groupId && quota.operationId == operationId && quota.updatedAt == request.time;
    }
    function validSparkRecoveryUpdate(uid, operationId) {
      let data = request.resource.data;
      let path = /databases/$(database)/documents/financialGroups/$(resource.data.groupId)/sparkOperations/$(operationId);
      return signedIn() && request.auth.uid == uid
        && data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) && data.updatedAt == request.time
        && ((resource.data.status == 'pending' && data.status == 'cancelled' && !existsAfter(path))
          || (resource.data.status == 'pending' && data.status == 'committed' && !exists(path)
            && getAfter(path).data.actorId == uid && getAfter(path).data.kind == resource.data.kind && getAfter(path).data.createdAt == request.time)
          || (resource.data.status == 'committed' && data.status == 'resolved'));
    }
    function validSparkIntentQuota(uid) {
      let data = request.resource.data;
      let path = /databases/$(database)/documents/sparkOperationRecovery/$(uid)/intents/$(data.operationId);
      return signedIn() && request.auth.uid == uid
        && data.keys().hasAll(['groupId', 'operationId', 'windowStartInMillis', 'count', 'updatedAt'])
        && data.keys().hasOnly(['groupId', 'operationId', 'windowStartInMillis', 'count', 'updatedAt'])
        && validSparkId(data.groupId) && validSparkOperationId(data.operationId)
        && data.windowStartInMillis is int && data.windowStartInMillis == int(request.time.toMillis() / 60000) * 60000
        && data.count is int && data.count > 0 && data.count <= 120 && data.updatedAt == request.time
        && (resource == null ? data.count == 1 : (resource.data.windowStartInMillis == data.windowStartInMillis && data.count == resource.data.count + 1)
          || (resource.data.windowStartInMillis < data.windowStartInMillis && data.count == 1))
        && !exists(path) && getAfter(path).data.groupId == data.groupId && getAfter(path).data.createdAt == request.time;
    }

    function validSparkTransferReversal(groupId, operationId, data, role) {
      let imported = data.get('originalSource', 'live') == 'imported';
      let originalPath = imported
        ? /databases/$(database)/documents/financialGroups/$(groupId)/sparkImportedIdentities/$(data.reversesOperationId)
        : /databases/$(database)/documents/financialGroups/$(groupId)/sparkOperations/$(data.reversesOperationId);
      let original = get(originalPath).data;
      let claimPath = imported
        ? /databases/$(database)/documents/financialGroups/$(groupId)/sparkImportedClaims/$(data.reversesOperationId)
        : /databases/$(database)/documents/financialGroups/$(groupId)/sparkReversals/$(data.reversesOperationId);
      return validSparkOperationId(data.reversesOperationId)
        && data.get('originalSource', 'live') in ['live', 'imported']
        && original.kind in ['transfer', 'investment_deposit', 'investment_redemption']
        && (!imported || original.pairResolutionAllowed == true)
        && (original.actorId == request.auth.uid || role == 'admin')
        && data.fromAccountId == original.toAccountId && data.toAccountId == original.fromAccountId
        && data.amountInCents == original.amountInCents
        && !exists(claimPath)
        && getAfter(claimPath).data.reversalOperationId == operationId;
    }

    function validSparkReversalClaim(groupId, originalId, kind) {
      let data = request.resource.data;
      let operationPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkOperations/$(data.reversalOperationId);
      let operation = getAfter(operationPath).data;
      // O guard financeiro valida papel/efeitos; a substituição certifica aqui sua fonte imutável.
      return signedIn() && data.actorId == request.auth.uid
        && data.keys().hasAll(['schemaVersion', 'actorId', 'reversalOperationId', 'createdAt'])
        && data.keys().hasOnly(['schemaVersion', 'actorId', 'reversalOperationId', 'createdAt'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && validSparkOperationId(originalId) && validSparkOperationId(data.reversalOperationId)
        && data.createdAt == request.time && !exists(operationPath)
        && operation.actorId == request.auth.uid && operation.createdAt == request.time
        && (operation.kind == kind ? operation.reversesOperationId == originalId
          : kind == 'adjustment_reversal' && operation.kind == 'adjustment_replacement'
            && operation.replacesOperationId == originalId && validSparkReplacementSource(groupId, originalId, operation));
    }

    function validSparkImportedPairClaim(groupId, originalId) {
      let data = request.resource.data;
      let path = /databases/$(database)/documents/financialGroups/$(groupId)/sparkOperations/$(data.reversalOperationId);
      let operation = getAfter(path).data;
      return isSparkProofMember(groupId) && data.keys().hasAll(['schemaVersion', 'actorId', 'reversalOperationId', 'createdAt'])
        && data.keys().hasOnly(['schemaVersion', 'actorId', 'reversalOperationId', 'createdAt'])
        && data.schemaVersion is int && data.schemaVersion == 1 && data.actorId == request.auth.uid && data.createdAt == request.time
        && validSparkOperationId(originalId) && validSparkOperationId(data.reversalOperationId) && !exists(path)
        && operation.kind == 'transfer_reversal' && operation.originalSource == 'imported'
        && operation.reversesOperationId == originalId && operation.actorId == request.auth.uid && operation.createdAt == request.time;
    }

    function validSparkReplacementSource(groupId, originalId, operation) {
      let original = get(/databases/$(database)/documents/financialGroups/$(groupId)/sparkOperations/$(originalId)).data;
      return original.kind in ['balance_adjustment', 'dated_adjustment', 'adjustment_replacement']
        && original.actorId == request.auth.uid && original.accountId == operation.accountId
        && operation.originalEffectiveAt == original.get('effectiveAt', original.createdAt)
        && operation.originalDifferenceInCents == original.differenceInCents;
    }

    function validSparkPositionCreate(groupId, accountId) {
      let data = request.resource.data;
      let operationPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkOperations/$(data.lastOperationId);
      let operation = getAfter(operationPath).data;
      return validSparkPosition(data) && data.active && data.revision == 0 && data.nextActivationAt == null
        && data.updatedAt == request.time && !exists(operationPath)
        && operation.actorId == request.auth.uid
        && (operation.kind == 'investment_opening'
          ? data.kind == 'investment' && operation.toAccountId == accountId && data.balanceInCents == operation.openingBalanceInCents
          : operation.kind in ['account_opening', 'bank_opening'] && data.balanceInCents == operation.openingBalanceInCents && operation.accountId == accountId && operation.accountKind == data.kind);
    }

    function validSparkOpening(groupId, operationId) {
      let data = request.resource.data;
      let positionPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkPositions/$(data.accountId);
      let position = getAfter(positionPath).data;
      let quota = getAfter(/databases/$(database)/documents/sparkTransferQuotas/$(request.auth.uid)).data;
      return data.keys().hasAll(['schemaVersion', 'actorId', 'kind', 'accountId', 'accountKind', 'openingBalanceInCents', 'note', 'createdAt'])
        && data.keys().hasOnly(['schemaVersion', 'actorId', 'kind', 'accountId', 'accountKind', 'openingBalanceInCents', 'note', 'createdAt', 'overdraftReason', 'name', 'colorHex', 'iconKey', 'bankAccountId', 'assetType', 'valuationMethod', 'cdiPercentageInBasisPoints', 'redemptionTerm', 'description'])
        && data.schemaVersion is int && data.schemaVersion == 1 && data.actorId == request.auth.uid
        && validSparkId(data.accountId) && data.accountKind in ['bank', 'cash', 'investment']
        && ((data.accountKind == 'cash' && data.accountId == 'cash') || (data.accountKind != 'cash' && data.accountId != 'cash'))
        && (data.kind == 'account_opening' ? data.openingBalanceInCents is int && data.openingBalanceInCents == 0 && !('overdraftReason' in data)
          : data.accountKind == 'bank' && isIntegerCents(data.openingBalanceInCents) && data.keys().hasAll(['name', 'overdraftReason'])
            && isShortText(data.overdraftReason, 500) && validSparkMovementBalance(data.openingBalanceInCents, data.overdraftReason)
            && !exists(/databases/$(database)/documents/financialGroups/$(groupId)/sparkCheckpoints/$(data.accountId))
            && getAfter(/databases/$(database)/documents/financialGroups/$(groupId)/sparkCheckpoints/$(data.accountId)).data.operationId == operationId)
        && (data.note == null || (data.note is string && data.note.size() <= 2000))
        && data.createdAt == request.time && !exists(positionPath)
        && position.lastOperationId == operationId && position.kind == data.accountKind
        && (data.keys().hasAny(['name'])
          ? !exists(/databases/$(database)/documents/financialGroups/$(groupId)/sparkAccountCatalog/$(data.accountId))
            && getAfter(/databases/$(database)/documents/financialGroups/$(groupId)/sparkAccountCatalog/$(data.accountId)).data.lastOperationId == operationId
          : data.keys().hasOnly(['schemaVersion', 'actorId', 'kind', 'accountId', 'accountKind', 'openingBalanceInCents', 'note', 'createdAt']))
        && quota.groupId == groupId && quota.lastOperationId == operationId && quota.updatedAt == request.time;
    }

    // [[Financiamento Inicial de Investimentos Spark]]: valor observado não é principal aplicado.
    function validSparkInvestmentOpening(groupId, operationId) {
      let data = request.resource.data;
      let fromPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkPositions/$(data.fromAccountId);
      let toPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkPositions/$(data.toAccountId);
      let catalogPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkAccountCatalog/$(data.toAccountId);
      let capitalPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkInvestmentCapital/$(data.toAccountId);
      let checkpointPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkCheckpoints/$(data.toAccountId);
      let bank = get(fromPath).data;
      let after = getAfter(fromPath).data;
      return data.keys().hasAll(['schemaVersion', 'actorId', 'kind', 'accountKind', 'fromAccountId', 'toAccountId', 'fromRevision', 'fromPreviousOperationId', 'amountInCents', 'openingBalanceInCents', 'valuationDifferenceInCents', 'name', 'colorHex', 'iconKey', 'bankAccountId', 'assetType', 'valuationMethod', 'cdiPercentageInBasisPoints', 'redemptionTerm', 'description', 'note', 'createdAt'])
        && data.keys().hasOnly(['schemaVersion', 'actorId', 'kind', 'dated', 'effectiveAt', 'fromCurrentEffectInCents', 'accountKind', 'fromAccountId', 'toAccountId', 'fromRevision', 'fromPreviousOperationId', 'amountInCents', 'openingBalanceInCents', 'valuationDifferenceInCents', 'name', 'colorHex', 'iconKey', 'bankAccountId', 'assetType', 'valuationMethod', 'cdiPercentageInBasisPoints', 'redemptionTerm', 'description', 'note', 'createdAt'])
        && data.schemaVersion is int && data.schemaVersion == 1 && data.actorId == request.auth.uid && data.createdAt == request.time
        && data.accountKind == 'investment' && validSparkId(data.fromAccountId) && validSparkId(data.toAccountId)
        && data.fromAccountId != data.toAccountId && data.toAccountId != 'cash' && data.bankAccountId == data.fromAccountId
        && isIntegerCents(data.amountInCents) && data.amountInCents > 0
        && isIntegerCents(data.openingBalanceInCents) && data.openingBalanceInCents >= 0
        && isIntegerCents(data.valuationDifferenceInCents) && data.valuationDifferenceInCents == data.openingBalanceInCents - data.amountInCents
        && data.fromRevision is int && bank.kind == 'bank' && bank.active
        && validSparkPair(bank, after, data.fromRevision, operationId)
        && data.dated is bool
        && (data.dated ? data.effectiveAt is timestamp && data.effectiveAt >= timestamp.value(0)
            && data.effectiveAt <= request.time && isIntegerCents(data.fromCurrentEffectInCents)
            && after.balanceInCents == bank.balanceInCents + data.fromCurrentEffectInCents
          : !data.keys().hasAny(['effectiveAt', 'fromCurrentEffectInCents'])
            && after.balanceInCents == bank.balanceInCents - data.amountInCents)
        && after.balanceInCents >= 0
        && !exists(toPath) && getAfter(toPath).data.lastOperationId == operationId
        && !exists(catalogPath) && getAfter(catalogPath).data.lastOperationId == operationId
        && !exists(capitalPath) && getAfter(capitalPath).data.lastOperationId == operationId
        && !exists(checkpointPath) && getAfter(checkpointPath).data.operationId == operationId
        && (data.note == null || data.note is string && data.note.size() <= 2000)
        && validSparkMovementQuota(groupId, operationId);
    }
    function validSparkInvestmentCapital(groupId, accountId) {
      let data = request.resource.data;
      let path = /databases/$(database)/documents/financialGroups/$(groupId)/sparkOperations/$(data.lastOperationId);
      let op = getAfter(path).data;
      return isSparkProofMember(groupId)
        && data.keys().hasAll(['schemaVersion', 'actorId', 'initialValueInCents', 'fundingAccountId', 'openingOperationId', 'revision', 'lastOperationId', 'updatedAt'])
        && data.keys().hasOnly(['schemaVersion', 'actorId', 'initialValueInCents', 'fundingAccountId', 'openingOperationId', 'revision', 'lastOperationId', 'updatedAt'])
        && data.schemaVersion is int && data.schemaVersion == 1 && data.actorId == request.auth.uid && data.updatedAt == request.time
        && data.revision is int && data.revision == 0 && validSparkOperationId(data.lastOperationId)
        && isIntegerCents(data.initialValueInCents) && data.initialValueInCents > 0
        && data.openingOperationId == data.lastOperationId && !exists(path)
        && op.kind == 'investment_opening' && op.toAccountId == accountId && op.actorId == request.auth.uid && op.createdAt == request.time
        && data.initialValueInCents == op.amountInCents && data.fundingAccountId == op.fromAccountId;
    }
    // [[Edição do Principal Spark]]: o capital serializa correções; a raiz permanece imutável.
    function validSparkEditedInvestment(groupId, operationId, data, before, after) {
      return data.keys().hasAny(['valuationOperationId', 'observedValueInCents'])
        ? validSparkOperationId(data.valuationOperationId) && data.valuationOperationId != operationId
          && isIntegerCents(data.observedValueInCents) && data.observedValueInCents >= 0
          && after.revision == before.revision + 2 && before.revision == data.toRevision
          && after.lastOperationId == data.valuationOperationId && after.balanceInCents == data.observedValueInCents
          && getAfter(/databases/$(database)/documents/financialGroups/$(groupId)/sparkOperations/$(data.valuationOperationId)).data.parentOperationId == operationId
        : validSparkPair(before, after, data.toRevision, operationId) && after.balanceInCents == before.balanceInCents + data.toCurrentEffectInCents;
    }
    function validSparkInvestmentEditValuation(groupId, operationId) {
      let data = request.resource.data;
      let parentPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkOperations/$(data.parentOperationId);
      let parent = getAfter(parentPath).data;
      let positionPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkPositions/$(data.accountId);
      let before = get(positionPath).data;
      let after = getAfter(positionPath).data;
      return data.keys().hasAll(['schemaVersion', 'actorId', 'kind', 'accountId', 'parentOperationId', 'previousOperationId', 'expectedRevision', 'targetBalanceInCents', 'previousBalanceInCents', 'differenceInCents', 'currentEffectInCents', 'effectiveAt', 'createdAt'])
        && data.keys().hasOnly(['schemaVersion', 'actorId', 'kind', 'accountId', 'parentOperationId', 'previousOperationId', 'expectedRevision', 'targetBalanceInCents', 'previousBalanceInCents', 'differenceInCents', 'currentEffectInCents', 'effectiveAt', 'createdAt'])
        && data.schemaVersion is int && data.schemaVersion == 1 && data.actorId == request.auth.uid && data.createdAt == request.time && data.effectiveAt == request.time
        && validSparkId(data.accountId) && validSparkOperationId(data.parentOperationId) && data.parentOperationId != operationId
        && !exists(parentPath) && parent.kind in ['investment_principal_update', 'investment_funding_change']
        && parent.actorId == request.auth.uid && parent.createdAt == request.time && parent.toAccountId == data.accountId
        && parent.valuationOperationId == operationId && parent.observedValueInCents == data.targetBalanceInCents
        && before.kind == 'investment' && before.active && before.lastOperationId == parent.toPreviousOperationId && before.revision == parent.toRevision
        && data.previousOperationId == data.parentOperationId && data.expectedRevision is int && data.expectedRevision == before.revision + 1
        && isIntegerCents(data.targetBalanceInCents) && data.targetBalanceInCents >= 0
        && parent.toCurrentEffectInCents == sparkMovementEffect(groupId, data.accountId, parent.effectiveAt,
          parent.kind == 'investment_funding_change' ? parent.differenceInCents : parent.amountInCents)
        && isIntegerCents(data.previousBalanceInCents) && data.previousBalanceInCents == before.balanceInCents + parent.toCurrentEffectInCents && data.previousBalanceInCents >= 0
        && isIntegerCents(data.differenceInCents) && data.differenceInCents == data.targetBalanceInCents - data.previousBalanceInCents
        && data.currentEffectInCents == data.differenceInCents
        && after.revision == before.revision + 2 && after.balanceInCents == data.targetBalanceInCents && after.lastOperationId == operationId
        && getAfter(/databases/$(database)/documents/financialGroups/$(groupId)/sparkCheckpoints/$(data.accountId)).data.operationId == operationId
        && validSparkMovementQuota(groupId, data.parentOperationId);
    }
    function validSparkInvestmentValuationReversal(groupId, operationId) {
      let data = request.resource.data;
      let positionPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkPositions/$(data.accountId);
      let before = get(positionPath).data;
      let after = getAfter(positionPath).data;
      let proof = get(/databases/$(database)/documents/financialGroups/$(groupId)/sparkHistoryProofs/$(data.proofId)).data;
      let original = get(/databases/$(database)/documents/financialGroups/$(groupId)/sparkOperations/$(data.reversesOperationId)).data;
      let referencePath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkCheckpoints/$(data.accountId);
      let claimPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkInvestmentValuationReversals/$(data.reversesOperationId);
      return data.keys().hasAll(['schemaVersion', 'actorId', 'kind', 'accountId', 'reversesOperationId', 'expectedRevision', 'proofId', 'effectiveAt', 'note', 'previousOperationId', 'targetBalanceInCents', 'previousBalanceInCents', 'differenceInCents', 'currentEffectInCents', 'createdAt'])
        && data.keys().hasOnly(['schemaVersion', 'actorId', 'kind', 'accountId', 'reversesOperationId', 'expectedRevision', 'proofId', 'effectiveAt', 'note', 'previousOperationId', 'targetBalanceInCents', 'previousBalanceInCents', 'differenceInCents', 'currentEffectInCents', 'createdAt'])
        && data.schemaVersion is int && data.schemaVersion == 1 && data.actorId == request.auth.uid && data.createdAt == request.time
        && validSparkId(data.accountId) && validSparkOperationId(data.reversesOperationId) && data.proofId == operationId
        && data.note is string && data.note.size() > 0 && data.note.size() <= 2000 && data.note.matches('\\S([\\s\\S]*\\S)?')
        && original.kind in ['investment_sync', 'investment_edit_valuation'] && original.accountId == data.accountId && data.effectiveAt == original.effectiveAt
        && get(referencePath).data.operationId == data.reversesOperationId
        && before.kind == 'investment' && validSparkPair(before, after, data.expectedRevision, operationId)
        && data.previousOperationId == before.lastOperationId && data.previousBalanceInCents == before.balanceInCents
        && proof.actorId == request.auth.uid && proof.accountId == data.accountId && proof.phase == 'done' && proof.purpose == 'valuation_undo'
        && proof.excludedCheckpointOperationId == data.reversesOperationId && proof.asOf == data.effectiveAt
        && proof.headRevision == before.revision && proof.headOperationId == before.lastOperationId
        && isIntegerCents(data.targetBalanceInCents) && data.targetBalanceInCents >= 0 && data.targetBalanceInCents == proof.balanceInCents
        && isIntegerCents(data.differenceInCents) && data.differenceInCents == data.targetBalanceInCents - original.targetBalanceInCents
        && isIntegerCents(data.currentEffectInCents) && data.currentEffectInCents == data.targetBalanceInCents + proof.tailDeltaInCents - before.balanceInCents
        && after.balanceInCents == before.balanceInCents + data.currentEffectInCents
        && getAfter(referencePath).data.operationId == operationId && !exists(claimPath) && getAfter(claimPath).data.reversalOperationId == operationId
        && validSparkMovementQuota(groupId, operationId);
    }
    function validSparkInvestmentPrincipal(groupId, operationId) {
      let data = request.resource.data;
      let fromPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkPositions/$(data.fromAccountId);
      let toPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkPositions/$(data.toAccountId);
      let capitalPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkInvestmentCapital/$(data.toAccountId);
      let bank = get(fromPath).data;
      let investment = get(toPath).data;
      return data.keys().hasAll(['schemaVersion', 'actorId', 'kind', 'fromAccountId', 'toAccountId', 'openingOperationId', 'expectedCapitalRevision', 'expectedCapitalOperationId', 'fromRevision', 'toRevision', 'principalInCents', 'previousPrincipalInCents', 'amountInCents', 'effectiveAt', 'fromCurrentEffectInCents', 'toCurrentEffectInCents', 'fromPreviousOperationId', 'toPreviousOperationId', 'note', 'overdraftReason', 'createdAt'])
        && data.keys().hasOnly(['schemaVersion', 'actorId', 'kind', 'fromAccountId', 'toAccountId', 'openingOperationId', 'expectedCapitalRevision', 'expectedCapitalOperationId', 'fromRevision', 'toRevision', 'principalInCents', 'previousPrincipalInCents', 'amountInCents', 'effectiveAt', 'fromCurrentEffectInCents', 'toCurrentEffectInCents', 'fromPreviousOperationId', 'toPreviousOperationId', 'note', 'overdraftReason', 'valuationOperationId', 'observedValueInCents', 'createdAt'])
        && validSparkMovementText(data) && validSparkId(data.fromAccountId) && validSparkId(data.toAccountId)
        && data.fromAccountId != data.toAccountId && bank.kind == 'bank' && investment.kind == 'investment'
        && isIntegerCents(data.principalInCents) && data.principalInCents >= 0
        && isIntegerCents(data.previousPrincipalInCents) && data.previousPrincipalInCents >= 0
        && isIntegerCents(data.amountInCents) && data.amountInCents == data.principalInCents - data.previousPrincipalInCents
        && data.expectedCapitalRevision is int && data.expectedCapitalRevision >= 0 && data.expectedCapitalRevision < 1000000000000
        && get(capitalPath).data.revision == data.expectedCapitalRevision
        && getAfter(capitalPath).data.revision == data.expectedCapitalRevision + 1 && getAfter(capitalPath).data.lastOperationId == operationId
        && data.fromRevision is int && data.toRevision is int
        && validSparkPair(bank, getAfter(fromPath).data, data.fromRevision, operationId)
        && validSparkEditedInvestment(groupId, operationId, data, investment, getAfter(toPath).data)
        && isIntegerCents(data.fromCurrentEffectInCents) && isIntegerCents(data.toCurrentEffectInCents)
        && getAfter(fromPath).data.balanceInCents == bank.balanceInCents + data.fromCurrentEffectInCents
        && validSparkMovementBalance(getAfter(fromPath).data.balanceInCents, data.overdraftReason)
        && validSparkMovementQuota(groupId, operationId);
    }
    function validSparkInvestmentCapitalUpdate(groupId, accountId) {
      let before = resource.data;
      let data = request.resource.data;
      let path = /databases/$(database)/documents/financialGroups/$(groupId)/sparkOperations/$(data.lastOperationId);
      let op = getAfter(path).data;
      let opening = get(/databases/$(database)/documents/financialGroups/$(groupId)/sparkOperations/$(before.openingOperationId)).data;
      return sparkProofRole(groupId) == 'admin'
        && data.diff(before).affectedKeys().hasOnly(['initialValueInCents', 'fundingAccountId', 'revision', 'lastOperationId', 'updatedAt'])
        && data.revision is int && data.revision <= 1000000000000
        && data.revision == before.revision + 1 && data.revision == op.expectedCapitalRevision + 1
        && isIntegerCents(data.initialValueInCents) && data.initialValueInCents >= 0
        && validSparkOperationId(data.lastOperationId) && !exists(path) && data.updatedAt == request.time
        && op.kind in ['investment_principal_update', 'investment_funding_change'] && op.actorId == request.auth.uid && op.createdAt == request.time
        && op.toAccountId == accountId
        && (op.kind == 'investment_funding_change' ? op.refundAccountId == before.fundingAccountId && data.fundingAccountId == op.fromAccountId
          : op.fromAccountId == before.fundingAccountId && data.fundingAccountId == before.fundingAccountId)
        && op.principalInCents == data.initialValueInCents && op.previousPrincipalInCents == before.initialValueInCents
        && op.expectedCapitalOperationId == before.lastOperationId && op.openingOperationId == before.openingOperationId
        && opening.kind == 'investment_opening' && opening.toAccountId == accountId
        && op.effectiveAt == opening.get('effectiveAt', opening.createdAt);
    }
    function validSparkFundingChange(groupId, operationId) {
      let data = request.resource.data;
      let fromPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkPositions/$(data.fromAccountId);
      let toPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkPositions/$(data.toAccountId);
      let refundPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkPositions/$(data.refundAccountId);
      let capitalPath = /databases/$(database)/documents/financialGroups/$(groupId)/sparkInvestmentCapital/$(data.toAccountId);
      let from = get(fromPath).data;
      let to = get(toPath).data;
      let refund = get(refundPath).data;
      return data.keys().hasAll(['schemaVersion', 'actorId', 'kind', 'fromAccountId', 'toAccountId', 'refundAccountId', 'fromRevision', 'toRevision', 'refundRevision', 'openingOperationId', 'expectedCapitalRevision', 'expectedCapitalOperationId', 'principalInCents', 'previousPrincipalInCents', 'amountInCents', 'differenceInCents', 'effectiveAt', 'fromCurrentEffectInCents', 'toCurrentEffectInCents', 'refundCurrentEffectInCents', 'fromPreviousOperationId', 'toPreviousOperationId', 'refundPreviousOperationId', 'note', 'overdraftReason', 'createdAt'])
        && data.keys().hasOnly(['schemaVersion', 'actorId', 'kind', 'fromAccountId', 'toAccountId', 'refundAccountId', 'fromRevision', 'toRevision', 'refundRevision', 'openingOperationId', 'expectedCapitalRevision', 'expectedCapitalOperationId', 'principalInCents', 'previousPrincipalInCents', 'amountInCents', 'differenceInCents', 'effectiveAt', 'fromCurrentEffectInCents', 'toCurrentEffectInCents', 'refundCurrentEffectInCents', 'fromPreviousOperationId', 'toPreviousOperationId', 'refundPreviousOperationId', 'note', 'overdraftReason', 'valuationOperationId', 'observedValueInCents', 'createdAt'])
        && validSparkMovementText(data) && validSparkId(data.fromAccountId) && validSparkId(data.toAccountId) && validSparkId(data.refundAccountId)
        && data.fromAccountId != data.toAccountId && data.fromAccountId != data.refundAccountId && data.toAccountId != data.refundAccountId
        && from.kind == 'bank' && refund.kind == 'bank' && to.kind == 'investment'
        && isIntegerCents(data.principalInCents) && data.principalInCents >= 0
        && isIntegerCents(data.previousPrincipalInCents) && data.previousPrincipalInCents >= 0
        && isIntegerCents(data.amountInCents) && data.amountInCents == data.principalInCents
        && isIntegerCents(data.differenceInCents) && data.differenceInCents == data.principalInCents - data.previousPrincipalInCents
        && data.expectedCapitalRevision is int && data.expectedCapitalRevision >= 0 && data.expectedCapitalRevision < 1000000000000
        && get(capitalPath).data.revision == data.expectedCapitalRevision
        && getAfter(capitalPath).data.revision == data.expectedCapitalRevision + 1 && getAfter(capitalPath).data.lastOperationId == operationId
        && data.fromRevision is int && data.toRevision is int && data.refundRevision is int
        && validSparkPair(from, getAfter(fromPath).data, data.fromRevision, operationId)
        && validSparkEditedInvestment(groupId, operationId, data, to, getAfter(toPath).data)
        && validSparkPair(refund, getAfter(refundPath).data, data.refundRevision, operationId)
        && isIntegerCents(data.fromCurrentEffectInCents) && isIntegerCents(data.toCurrentEffectInCents) && isIntegerCents(data.refundCurrentEffectInCents)
        && getAfter(fromPath).data.balanceInCents == from.balanceInCents + data.fromCurrentEffectInCents
        && getAfter(refundPath).data.balanceInCents == refund.balanceInCents + data.refundCurrentEffectInCents
        && validSparkMovementBalance(getAfter(fromPath).data.balanceInCents, data.overdraftReason)
        && validSparkMovementBalance(getAfter(refundPath).data.balanceInCents, data.overdraftReason)
        && validSparkMovementQuota(groupId, operationId);
    }
    function validSparkOperation(groupId, operationId) {
      let role = sparkProofRole(groupId);
      let kind = request.resource.data.kind;
      return role in ['admin', 'member'] && validSparkOperationId(operationId)
        // Fluxos ordinários são frequentes e não devem percorrer todos os demais contratos.
        && (kind in ['income', 'expense', 'movement_reversal']
          ? validSparkMovement(groupId, operationId)
          : kind == 'movement_correction'
            ? validSparkMovementCorrection(groupId, operationId)
          // Conferências temporais também precisam de margem para histórico e saldo negativo.
          : kind in ['dated_adjustment', 'dated_reconciliation', 'investment_sync', 'monthly_opening']
            ? role == 'admin' && validSparkDatedChange(groupId, operationId)
          : kind == 'monthly_activation'
            ? validSparkMonthlyActivation(groupId, operationId)
          // Ajuste composto negativo também precisa caber no orçamento de expressões.
          : kind == 'adjustment_replacement'
            ? role == 'admin' && validSparkAdjustmentReplacement(groupId, operationId)
          : kind in ['account_opening', 'bank_opening']
          ? role == 'admin' && validSparkOpening(groupId, operationId)
          : kind == 'investment_opening'
            ? role == 'admin' && validSparkInvestmentOpening(groupId, operationId)
          : kind == 'investment_principal_update'
            ? role == 'admin' && validSparkInvestmentPrincipal(groupId, operationId)
          : kind == 'investment_funding_change'
            ? role == 'admin' && validSparkFundingChange(groupId, operationId)
          : kind == 'investment_edit_valuation'
            ? role == 'admin' && validSparkInvestmentEditValuation(groupId, operationId)
          : kind == 'investment_valuation_reversal'
            ? role == 'admin' && validSparkInvestmentValuationReversal(groupId, operationId)
          : kind == 'account_catalog_update'
            ? role == 'admin' && validSparkAccountCatalogReceipt(groupId, operationId)
          : kind == 'account_lifecycle_update'
            ? role == 'admin' && validSparkAccountLifecycleReceipt(groupId, operationId)
          : kind == 'investment_cdi_update'
            ? validSparkCdiReceipt(groupId, operationId)
          : kind in ['category_save', 'category_delete']
            ? validSparkCategoryReceipt(groupId, operationId)
          : kind == 'recurring_plan_create'
            ? validSparkRecurringCreationReceipt(groupId, operationId)
          : kind == 'recurring_plan_update'
            ? validSparkRecurringUpdateReceipt(groupId, operationId)
          : kind in ['recurring_replan', 'recurring_replan_reversal']
            ? validSparkRecurringReplanReceipt(groupId, operationId)
          : kind == 'recurring_metadata_update'
            ? validSparkRecurringMetadataReceipt(groupId, operationId)
          : kind in ['recurring_settlement', 'recurring_reversal']
            ? validSparkRecurringMovement(groupId, operationId)
          : kind in ['account_count', 'balance_adjustment']
            ? role == 'admin' && validSparkBalanceChange(groupId, operationId)
            : kind == 'adjustment_reversal'
              ? role == 'admin' && validSparkAdjustmentReversal(groupId, operationId)
              : validSparkPairOperation(groupId, operationId, role));
    }

    // [[Operações Ordinárias Spark]]: efeito atual respeita a referência, histórico conserva a data.
    function sparkMovementEffect(groupId, accountId, at, delta) {
      let path = /databases/$(database)/documents/financialGroups/$(groupId)/sparkCheckpoints/$(accountId);
      return !exists(path) || at > get(path).data.effectiveAt || (at == get(path).data.effectiveAt && get(path).data.includesBoundary) ? delta : 0;
    }

    function validSparkMovementText(data) {
      return data.schemaVersion is int && data.schemaVersion == 1 && data.actorId == request.auth.uid
        && data.effectiveAt is timestamp && data.effectiveAt >= timestamp.value(0) && data.effectiveAt <= request.time
        && data.createdAt == request.time
        && (data.note == null || data.note is string && data.note.size() <= 2000)
        && (data.overdraftReason == null || data.overdraftReason is string && data.overdraftReason.size() <= 500);
    }

    function validSparkMovementBalance(balance, reason) {
      return balance >= 0 || reason is string && reason.size() >= 3 && reason.matches('\\S([\\s\\S]*\\S)?');
    }

    function validSparkMovementQuota(groupId, operationId) {
      let quota = getAfter(/databases/$(database)/documents/sparkTransferQuotas/$(request.auth.uid)).data;
      return quota.groupId == groupId && quota.lastOperationId == operationId && quota.updatedAt == request.time;
    }

    function validSparkMetadataConfirmation(data) {
      return isShortText(data.get('expectedFingerprint', null), 160) && isShortText(data.get('assistantRequestFingerprint', null), 160)
        && isShortText(data.get('commandMaterial', null), 16000);
    }
    function validSparkAccountLifecycleReceipt(groupId, operationId) {
      let data = request.resource.data;
      let state = getAfter(/databases/$(database)/documents/financialGroups/$(groupId)/sparkAccountStates/$(data.accountId)).data;
      return data.keys().hasAll(['schemaVersion', 'actorId', 'kind', 'accountId', 'expectedPositionRevision', 'expectedLifecycleRevision', 'isActive', 'archived', 'createdAt'])
        && data.keys().hasOnly(['schemaVersion', 'actorId', 'kind', 'accountId', 'expectedPositionRevision', 'expectedLifecycleRevision', 'isActive', 'archived', 'createdAt'])
        && data.schemaVersion is int && data.schemaVersion == 1 && data.actorId == request.auth.uid && data.createdAt == request.time
        && validSparkId(data.accountId) && state.lastOperationId == operationId && state.updatedAt == request.time
        && validSparkMovementQuota(groupId, operationId);
    }
    function validSparkAccountState(groupId, accountId) {
      let data = request.resource.data;
