        && data.keys().hasOnly(['schemaVersion', 'personId', 'groupId', 'name', 'usageType', 'isMandatoryExpense', 'isMandatoryGain', 'showInBothLists', 'iconFamily', 'iconName', 'iconStyle', 'historyKnown', 'deleted', 'revision', 'lastOperationId', 'createdAt', 'updatedAt'])
