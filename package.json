{
  "name": "finances-app",
  "version": "2.3.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "version:set": "node script/update_app_version.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "web:serve": "npm run web:export && npx -y firebase-tools@latest emulators:start --project emulator --only hosting",
    "web:deploy": "EXPO_PUBLIC_APP_ENV=production EXPO_PUBLIC_FIREBASE_TARGET=production EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN= npm run web:export && npx -y firebase-tools@latest deploy --project production --only hosting",
    "web:deploy:preview": "EXPO_PUBLIC_APP_ENV=preview EXPO_PUBLIC_FIREBASE_TARGET=production EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN= npm run web:export && npx -y firebase-tools@latest hosting:channel:deploy preview --project production --expires 7d",
    "emulators:start": "npx -y firebase-tools@latest emulators:start --project emulator --only auth,firestore,functions",
    "emulators:seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_PROJECT_ID=demo-lumus-financas npm --prefix backend run seed",
    "dev:local": "./script/build_and_run.sh start",
    "dev:local:web": "./script/build_and_run.sh --web",
    "test:integration": "npm --prefix backend run test:emulator",
    "test": "jest",
    "lint:styles": "node script/check_style_architecture.js",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "tsc --noEmit -p backend/tsconfig.json",
    "check": "npm run lint:styles && npm run typecheck && npm run typecheck:backend && npm run test -- --runInBand",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
